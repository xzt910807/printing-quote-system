DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=printing_quote
DB_POOL_LIMIT=10

PORT=3000

# Agnes AI 文本模型（OpenAI 兼容接口。配置后 /api/quote/nl 的 AI 参数解析优先走 Agnes
# （统一走 src/services/llmService.js），DEEPSEEK_API_KEY 转为回退通道。
# 默认直连 Agnes 官方 apihub.agnes-ai.com/v1 + agnes-3.0-flash；
# 自建 new-api 网关的部署（如 AI 生图同款网关）把 BASE 指过去即可，
# 注意网关需有对应文本模型渠道且令牌允许该模型）
AGNES_API_KEY=
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# AGNES_TEXT_MODEL=agnes-3.0-flash
DEEPSEEK_API_KEY=

# 管理后台登录：账户制（admin_user 表），初始账号 admin / admin123456，登录后请立即修改密码
# 工厂端登录：工厂账号（factory.username / password_hash），由工厂自助注册后经管理员审核激活

# 微信小程序（配置后启用真实微信登录；两个都留空则自动降级为开发身份，便于本地调试）
WX_APPID=
WX_SECRET=

# 微信订阅消息模板ID（微信公众平台-订阅消息-我的模板申请后填入；
# 未配置时跳过订阅推送（不影响主流程）；小程序端会自动从 /api/c/config 拉取）
# 注：模板数据字段名需与微信后台申请的一致，详见 src/services/wxService.js 注释
WX_TMPL_ORDER_ACCEPTED=
WX_TMPL_ORDER_SHIPPED=

# 快递100 物流轨迹查询（https://poll.kuaidi100.com 申请 KEY+CUSTOMER；
# 两个都留空则物流轨迹降级为「未配置」，发货信息照常录入与展示，不影响签收流程）
KUAIDI100_KEY=
KUAIDI100_CUSTOMER=

# F-105 语音识别（讯飞开放平台 https://www.xfyun.cn 创建「语音听写」应用获取；
# 三个都留空则 /api/voice/recognize 返回「未配置」，小程序语音按钮提示不可用，不影响其它流程。
# 个人主体小程序无法用微信同声传译插件时走此通道；个体户开通后可切回插件）
XF_APP_ID=
XF_API_KEY=
XF_API_SECRET=

# 微信支付 v3（JSAPI）：全部配齐才启用真实支付，任一留空则支付接口提示「未配置」，
# 小程序侧可用模拟支付或线下转账（工厂端确认收款）。需企业/个体户资质申请商户号。
# WXPAY_PRIVATE_KEY_PATH 为商户私钥文件（apiclient_key.pem）在服务器的绝对路径；
# WXPAY_NOTIFY_URL 必须公网可达且指向本服务 /api/c/pay/notify
WXPAY_APPID=
WXPAY_MCHID=
WXPAY_APIV3_KEY=
WXPAY_SERIAL_NO=
WXPAY_PRIVATE_KEY_PATH=
WXPAY_NOTIFY_URL=

# 微信支付 v3 回调验签（P0 资损防线，二选一，未就绪则真实回调一律 401 拦截）：
# ① 平台证书模式（默认）：无需额外配置，服务用 WXPAY_APIV3_KEY 自动下载并缓存平台证书验签；
# ② 公钥模式（商户号 2024-09 后新申请多为公钥模式）：填入公钥 ID + 公钥文件绝对路径。
# 注：WXPAY_APIV3_KEY 必须为 32 位原文（回调解密直接用其字节作 AES-256-GCM 密钥，不做哈希）。
# WXPAY_PUBLIC_KEY_ID=
# WXPAY_PUBLIC_KEY_PATH=

# ===== 监控告警（P1）=====
# 告警 Webhook：cron 心跳异常 / 迁移未执行 / 支付验签未就绪 时推送。
# 支持企业微信群机器人 与 钉钉群机器人（按 URL 特征自动适配），留空则仅写管理员站内信。
# ALERT_WEBHOOK_URL=
# cron 心跳超此分钟数判定为 stale（tick 默认每 30 分钟一次，45 留缓冲），/health 与告警据此判断
# CRON_STALE_MINUTES=45
# 置 1 时 /health 在 cron 心跳异常/degraded 情况下返回 HTTP 503，供外部拨测（如 UptimeRobot）直接告警
# HEALTH_STRICT=1

# 021-b AI 设计参考图（new-api 的 OpenAI 兼容生图接口；API_KEY 留空则 ai-gen 返回「未配置」。
# 生产部署在同一台服务器时 BASE 用回环地址即可，令牌在 new-api 后台创建、限 agnes-image 模型）
AI_IMAGE_BASE_URL=http://127.0.0.1:3000/v1
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=agnes-image-2.5-flash

# ===== 内容安全（微信 msgSecCheck 文本护栏）=====
# 覆盖入口：询价联系人与设计备注、IM 会话消息、昵称与公司名、收货人与详细地址、
# 退款理由、工厂设备图注。依赖 WX_APPID/WX_SECRET 且提交者需有真实 openid
#（匿名请求与 dev_ 开发身份自动放行）。
# 设计原则是降级优先于拦截：接口限流/超时/异常一律放行，仅微信明确判定 risky 才拒绝提交。
# SEC_TEXT_ENABLED=0     # 置 0 一键停用全部文本检测（排障或微信接口故障期临时用）
# SEC_REVIEW_BLOCK=0     # 置 1 时连 review（疑似）一并拦截，默认仅拦 risky
# SEC_TIMEOUT_MS=1500    # 单次检测超时即降级放行，避免拖慢业务响应

# ===== 业务参数 =====
# 平台服务费率（工厂成交额抽佣，取值 0~0.5，默认 0.05 即 5%；分账执行待服务商资质下发后对接）
# SERVICE_FEE_RATE=0.05
# 未支付订单自动取消时限（小时，默认 24，由 cron 任务执行）
# PAY_TIMEOUT_HOURS=24
# 工厂自报产能视为过期的时长（小时，默认 72；过期后撮合不再给闲置加权）
# CAPACITY_TTL_HOURS=72
# 制版 PDF 中文字体（Linux 服务器需自备字体文件，否则中文渲染为方块）
# PDF_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-microhei.ttc
# PDF_FONT_FAMILY=       # 留空时按字体文件名推断 ttc 内字体族名

# ===== 运维工具 =====
# mysqlbinlog 可执行文件路径（scripts/binlog-rescue.js 用；
# 留空则自动探测 C/D 盘 MySQL Server 8.0 默认安装位置）
# MYSQLBINLOG=
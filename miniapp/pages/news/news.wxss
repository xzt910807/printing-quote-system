.navbar { position: fixed; top: 0; left: 0; right: 0; background: #fff; z-index: 100; box-shadow: 0 1px 4px rgba(0,0,0,.05); }
.navbar-inner { display: flex; align-items: center; position: relative; }
.navbar-back { width: 44rpx; height: 44rpx; display: flex; align-items: center; justify-content: center; font-size: 40rpx; color: #333; margin-left: 12rpx; }
.navbar-title { flex: 1; text-align: center; font-size: 32rpx; font-weight: 400; margin-right: 56rpx; }

.page { padding: 20rpx; padding-top: 200rpx; min-height: 100vh; background: #f5f6fa; box-sizing: border-box; }

.cat-bar { white-space: nowrap; background: #fff; border-radius: 12rpx; padding: 12rpx; margin-bottom: 20rpx; }
.cat-item { display: inline-block; padding: 12rpx 28rpx; margin-right: 12rpx; border-radius: 30rpx; background: #f2f3f5; color: #666; font-size: 26rpx; }
.cat-active { background: #2563eb; color: #fff; }

.news-card { background: #fff; border-radius: 12rpx; padding: 20rpx; margin-bottom: 16rpx; display: flex; align-items: flex-start; }
.news-cover { width: 180rpx; height: 130rpx; border-radius: 8rpx; margin-right: 16rpx; flex-shrink: 0; background: #eee; }
.news-body { flex: 1; min-width: 0; }
.news-title { font-size: 30rpx; font-weight: 600; color: #222; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.news-sum { font-size: 24rpx; color: #666; margin-top: 8rpx; line-height: 1.5; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.news-meta { display: flex; justify-content: space-between; margin-top: 12rpx; font-size: 22rpx; color: #999; }

.empty { text-align: center; color: #999; padding: 100rpx 0; font-size: 26rpx; }
.load-tip { text-align: center; color: #999; padding: 24rpx 0; font-size: 24rpx; }

/* 032 订阅 chips：选中浅蓝实心、未选白底细描边，去 ✓ 字符靠底色区分 */
.sub-bar { display: flex; flex-wrap: wrap; align-items: center; background: #fff; border-radius: 12rpx; padding: 14rpx 16rpx; margin-bottom: 16rpx; }
.sub-hint { font-size: 22rpx; color: #94a3b8; margin-right: 14rpx; }
.sub-chip { font-size: 23rpx; color: #94a3b8; padding: 8rpx 24rpx; margin-right: 12rpx; border-radius: 30rpx; background: #fff; border: 1rpx solid #e2e8f0; }
.sub-on { color: #2563eb; background: #eff6ff; border-color: #dbeafe; font-weight: 600; }

/* 031 编辑精选 banner：品牌蓝渐变卡，白字 + 半透明徽章 */
.feat-swiper { height: 264rpx; border-radius: 16rpx; overflow: hidden; margin-bottom: 20rpx; box-shadow: 0 10rpx 28rpx rgba(37, 99, 235, .28); }
.feat-item { display: flex; height: 100%; align-items: stretch; background: linear-gradient(135deg, #4f7cff 0%, #2563eb 55%, #1d4ed8 100%); }
.feat-cover { width: 240rpx; height: 100%; flex-shrink: 0; background: #eee; }
.feat-body { flex: 1; padding: 28rpx 30rpx; display: flex; flex-direction: column; justify-content: center; min-width: 0; }
.feat-top { display: flex; align-items: center; margin-bottom: 12rpx; }
.feat-badge { font-size: 20rpx; color: #fff; background: rgba(255,255,255,.2); border: 1rpx solid rgba(255,255,255,.35); padding: 4rpx 16rpx; border-radius: 999rpx; }
.feat-cat { font-size: 22rpx; color: rgba(255,255,255,.75); margin-left: 14rpx; }
.feat-title { font-size: 30rpx; font-weight: 600; color: #fff; line-height: 1.45; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.feat-note { font-size: 22rpx; color: rgba(255,255,255,.72); margin-top: 10rpx; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* 列表内精选小徽标（替代大橙星） */
.news-feat-tag { display: inline-block; font-size: 20rpx; color: #fff; background: linear-gradient(135deg, #f59e0b, #ea580c); border-radius: 6rpx; padding: 2rpx 12rpx; margin-right: 12rpx; vertical-align: 4rpx; }
/* 编辑提示：琥珀左侧线提示条（与精选同色系，不再用紫色干扰正文） */
.news-editor { font-size: 22rpx; color: #92400e; background: #fffbeb; border-left: 6rpx solid #fbbf24; padding: 10rpx 16rpx; border-radius: 0 8rpx 8rpx 0; margin-top: 12rpx; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* meta 行：分类彩色小标签 + 来源居左，时间居右 */
.meta-left { display: flex; align-items: center; min-width: 0; }
.news-cat { font-size: 20rpx; color: #64748b; background: #f1f5f9; border-radius: 6rpx; padding: 2rpx 12rpx; margin-right: 12rpx; flex-shrink: 0; }
.news-cat-policy { color: #2563eb; background: #eff6ff; }
.news-cat-market { color: #d97706; background: #fff7ed; }
.news-cat-tech { color: #059669; background: #ecfdf5; }
.news-cat-material { color: #6d28d9; background: #f5f3ff; }

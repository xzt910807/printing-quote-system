<view class="navbar" style="padding-top: {{statusBarHeight}}px;">
  <view class="navbar-inner" style="height: {{navBarHeight}}px;">
    <view class="navbar-back" bindtap="goBack">‹</view>
    <view class="navbar-title">工单详情</view>
  </view>
</view>

<view class="page" wx:if="{{ticket}}">
  <view class="hd">
    <view class="hd-no" catchtap="copyTicketNo" data-no="{{ticket.ticket_no}}">{{ticket.ticket_no}}<text class="hd-copy-ic">⧉</text></view>
    <view class="hd-status st-{{ticket.status}}">{{statusLabel}}</view>
  </view>

  <view class="row"><text class="lbl">类型</text><text>{{typeLabel}}</text></view>
  <view class="row"><text class="lbl">订单</text><text>{{ticket.order_no || ('#' + ticket.order_id)}}</text></view>
  <view class="row"><text class="lbl">工厂</text><text>{{ticket.factory_name || ('#' + ticket.factory_id)}}</text></view>
  <view class="row"><text class="lbl">创建</text><text>{{ticket.timeText || ticket.created_at}}</text></view>

  <view class="card">
    <view class="card-title">问题描述</view>
    <view class="tk-title">{{ticket.title}}</view>
    <view class="tk-desc" wx:if="{{ticket.description}}">{{ticket.description}}</view>
  </view>

  <view class="card" wx:if="{{ticket.images && ticket.images.length}}">
    <view class="card-title">凭证</view>
    <view class="imgs">
      <image wx:for="{{ticket.images}}" wx:key="*this" src="{{item}}" mode="aspectFill"
             class="img-prev" data-url="{{item}}" bindtap="previewImage"/>
    </view>
  </view>

  <view class="card" wx:if="{{ticket.factory_reply}}">
    <view class="card-title">工厂回复</view>
    <view class="reply">{{ticket.factory_reply}}</view>
  </view>

  <view class="card" wx:if="{{ticket.admin_note}}">
    <view class="card-title">平台备注</view>
    <view class="reply note">{{ticket.admin_note}}</view>
  </view>

  <!-- 026+027 证据附件列表 + 追加上传 -->
  <view class="card">
    <view class="card-title">证据附件（共 {{files.length}} 个）</view>
    <view wx:if="{{!files.length}}" class="files-empty">暂无附件</view>
    <view wx:for="{{files}}" wx:key="id" class="file-row" data-url="{{item.fullUrl}}" data-image="{{item.isImage}}" bindtap="openFile">
      <image wx:if="{{item.isImage}}" class="file-thumb" src="{{item.fullUrl}}" mode="aspectFill" lazy-load />
      <view class="file-name">{{item.file_name}}</view>
      <view class="file-meta">{{item.sender_type === 'user' ? (role === 'customer' ? '我' : '客户') : (item.sender_type === 'factory' ? (role === 'factory' ? '我' : '工厂') : '平台')}} · {{item.sizeText}}</view>
    </view>
    <view class="file-upload {{uploading ? 'disabled' : ''}}" bindtap="chooseFile">
      {{uploading ? '上传中…' : '+ 追加证据'}}
    </view>
  </view>

  <view class="btn-primary" wx:if="{{ticket.status === 'resolved'}}" bindtap="close">
    {{closing ? '处理中…' : '确认关闭工单'}}
  </view>
</view>

<view wx:elif="{{!loading}}" class="empty">工单不存在</view>

<!-- Stage11 自定义导航栏 -->
<view class="navbar" style="padding-top: {{statusBarHeight}}px;">
  <view class="navbar-inner" style="height: {{navBarHeight}}px;">
    <view class="navbar-title">找厂</view>
  </view>
</view>

<view class="container page-tab">

  <!-- 名称搜索框（与下方筛选叠加生效；支持名称/地址关键词） -->
  <view class="search-bar">
    <view class="search-box">
      <view class="search-icon"><view class="ic ic-search"><view class="ic-a"></view></view></view>
      <input class="search-input" value="{{keyword}}" placeholder="搜索工厂名称 / 地址"
             placeholder-class="search-ph" confirm-type="search" bindinput="onKeywordInput" />
      <text class="search-clear" wx:if="{{keyword}}" bindtap="clearKeyword">✕</text>
    </view>
  </view>

  <!-- F-100 排序：综合 / 产能空闲 / 评分高 / 接单多 / 响应快 / 距离最近 -->
  <!-- 距离项：没拿到定位时置灰（点了会引导开定位，而不是默默换一个序） -->
  <scroll-view scroll-x class="sort-bar" enhanced show-scrollbar="{{false}}">
    <view class="sort-chip {{sort === item.code ? 'sort-on' : ''}} {{item.code === 'distance' && !userGeo ? 'sort-dim' : ''}}"
          wx:for="{{sortOptions}}" wx:key="code"
          data-code="{{item.code}}" bindtap="setSort">{{item.name}}</view>
  </scroll-view>

  <!-- 筛选栏 -->
  <view class="card filter-card">
    <!-- 030 地区筛选：二级 picker (省 + 市)，选中后拼入 /api/factory/list?province=&city= -->
    <view class="filter-row">
      <text class="filter-label">地区</text>
      <view class="filter-tags">
        <picker class="region-picker" mode="multiSelector" range="{{regionRange}}" value="{{regionIndex}}"
                bindcolumnchange="onRegionColumnChange" bindchange="onRegionChange">
          <view class="tag tag-picker {{filter.province ? 'tag-active' : ''}}">
            {{filter.province ? filter.province + ' · ' + filter.city : '全部地区 ›'}}
          </view>
        </picker>
        <view class="tag tag-picker" wx:if="{{filter.province}}" bindtap="clearRegion">✕ 清除</view>
      </view>
    </view>

    <view class="filter-row">
      <text class="filter-label">信任</text>
      <view class="filter-tags">
        <!-- F-6：只看已验真（向后端传 verified=1）。默认不选：线上未验真工厂占多数，
             默认开启会让人以为平台没几家厂 -->
        <view class="tag {{verifiedOnly ? 'tag-active' : ''}}" bindtap="toggleVerified">✓ 只看已验真</view>
      </view>
    </view>

    <view class="filter-row">
      <text class="filter-label">产品</text>
      <view class="filter-tags">
        <view class="tag {{filter.productType === item.code ? 'tag-active' : ''}}"
              wx:for="{{productOptions}}" wx:key="code"
              data-type="productType" data-code="{{item.code}}" bindtap="setFilter">{{item.name}}</view>
      </view>
    </view>

    <view class="filter-row">
      <text class="filter-label">工艺</text>
      <view class="filter-tags">
        <view class="tag {{item.selected ? 'tag-active' : ''}}"
              wx:for="{{processOptions}}" wx:key="code"
              data-type="process" data-code="{{item.code}}" bindtap="setFilter">
          {{item.name}}
        </view>
      </view>
    </view>
  </view>

  <!-- 工厂列表 -->
  <view class="empty" wx:if="{{factoriesLoading && !factories.length}}">
    <text class="empty-icon">⏳</text>加载中...
  </view>
  <view class="factory-item" wx:for="{{factories}}" wx:key="id">
    <view class="fi-head" bindtap="goFactoryDetail" data-id="{{item.id}}">
      <!-- 首字头像：按工厂名 hash 固定配色（utils/avatar） -->
      <view class="fi-avatar" style="background: {{item.avatarColor}}">{{item.avatarText}}</view>
      <view class="fi-info">
        <view class="factory-name">{{item.name}}</view>
        <view class="factory-addr"><view class="ic-inline"><view class="ic ic-pin"><view class="ic-a"></view></view></view>{{item.address || '龙港'}}</view>
        <!-- 印查查式信任/产能徽章 -->
        <view class="fi-trust" wx:if="{{item.trustLabel || item.capacityLabel}}">
          <text class="fi-verified" wx:if="{{item.trustLabel}}">✓ {{item.trustLabel}}</text>
          <text class="fi-cap fi-cap-{{item.capacityStatus}}" wx:if="{{item.capacityLabel}}">⚡ {{item.capacityLabel}}</text>
        </view>
        <!-- F-100：评分 / 接单量徽标（后端排序已按此加权）；距离为 Batch D2，没定位时不显示 -->
        <view class="fi-stats" wx:if="{{item.ratingText || item.acceptsText || item.distanceText}}">
          <text class="fi-stat fi-star" wx:if="{{item.ratingText}}">★ {{item.ratingText}}</text>
          <text class="fi-stat" wx:if="{{item.acceptsText}}">已接 {{item.acceptsText}}</text>
          <text class="fi-stat fi-dist" wx:if="{{item.distanceText}}">📍 {{item.distanceText}}</text>
        </view>
      </view>
      <!-- 关注：列表内直接收藏（catchtap 防冒泡进详情页）, 关注后撮合优先派单 -->
      <view class="fi-follow {{item.followed ? 'fi-follow-on' : ''}}" catchtap="toggleFollow"
            data-id="{{item.id}}" data-name="{{item.name}}">
        <text class="fi-follow-ic">{{item.followed ? '★' : '☆'}}</text>
        <text class="fi-follow-tx">{{item.followed ? '已关注' : '关注'}}</text>
      </view>
      <view class="fi-more"></view>
    </view>
    <view class="cap-row">
      <text class="cap-tag" wx:for="{{item.capNameList}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="btn-outline fi-btn" catchtap="quickQuote" data-id="{{item.id}}">报价 →</view>
  </view>

  <view wx:if="{{factories.length === 0}}" class="empty">
    <view class="empty-ic"><view class="ic ic-factory"><view class="ic-a"></view></view></view>
    没有符合条件的工厂，换个筛选条件试试
  </view>
</view>

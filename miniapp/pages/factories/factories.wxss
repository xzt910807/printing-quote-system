.filter-card { padding: 24rpx 28rpx 8rpx; }

/* ---------- 名称搜索框 ---------- */
.search-bar { padding: 24rpx 0 8rpx; }

.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 999rpx;
  padding: 0 28rpx;
  height: 76rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.05);
}

.search-icon {
  display: flex;
  align-items: center;
  margin-right: 14rpx;
  color: #94a3b8;
}

.search-input { flex: 1; font-size: 28rpx; color: #0f172a; height: 76rpx; }

.search-ph { color: #94a3b8; font-size: 28rpx; }

.search-clear {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #e2e8f0;
  color: #64748b;
  font-size: 22rpx;
  flex: none;
}

.filter-row {
  display: flex;
  align-items: flex-start;
  padding-bottom: 16rpx;
}

/* 标签与第一行 chip 垂直居中：line-height 取 chip 的实际高度
   （8rpx 上下内边距 ×2 + 24rpx 字 × 1.4 行高 ≈ 50rpx），不再用 padding-top 硬凑 */
.filter-label {
  width: 76rpx;
  font-size: 24rpx;
  line-height: 50rpx;
  color: #64748b;
}

.filter-tags { flex: 1; display: flex; flex-wrap: wrap; gap: 12rpx; }

/* 快筛行：地区 + 信任并排一行，不带左侧标签列。
   原来这两项各占一整行、左边挂「地区/信任」标签，每行只有一颗 chip，空得像表单 */
.quick-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  padding-bottom: 16rpx;
}

/* 地区 chip 里的清除：并进 chip 当关闭按钮。只在蓝底（已选地区）时出现，
   所以分隔线用半透明白；单独一颗「✕ 清除」挨着信任 chip 时容易被误读成清除信任 */
.tag-x {
  margin-left: 10rpx;
  padding-left: 10rpx;
  font-size: 20rpx;
  opacity: 0.8;
  border-left: 1rpx solid rgba(255, 255, 255, 0.4);
}

/* 「只看已验真」是开关，不是筛选项：靠右、不套灰底 chip、前面一个小勾选框。
   左边「全部地区」是"点开弹层"，右边这个是"就地切换"，两者的交互不一样，
   长成同一个灰块就分不出来；勾也只在选中时出现（未选中还打勾＝看着像勾了但灰着） */
.verify-toggle {
  margin-left: auto;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #64748b;
  padding: 8rpx 4rpx 8rpx 12rpx;
}

.verify-box {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  box-sizing: border-box;
  border: 1rpx solid #cbd5e1;
  border-radius: 8rpx;
  background: #fff;
  text-align: center;
  line-height: 26rpx;
  font-size: 18rpx;
  color: #fff;
}

.verify-on {
  color: #2563eb;
  font-weight: 500;
}

.verify-on .verify-box {
  background: #2563eb;
  border-color: #2563eb;
}

/* 筛选卡里的 chip（地区 / 产品 / 工艺）统一收一档：24rpx 字 + 8/22 内边距 + 1rpx 边框，
   和地区弹层里的字号（正文 26rpx、辅助 24rpx）是同一档。
   字色比全局 .tag（#64748b）压深一档，小字号下更实 */
.filter-card .tag {
  padding: 8rpx 22rpx;
  font-size: 24rpx;
  line-height: 1.4;
  border-width: 1rpx;
  color: #475569;
}

/* 选中态：蓝底 / 蓝边 / 加粗来自全局 .tag-active，但那边只是单类（0,1,0），
   字色会被上面 .filter-card .tag（0,2,0）压回 #475569 —— 这里只把字色补回白。
   （地区 chip 早先自带过一个单类选择器，和全局 .tag-active 打平、页面后加载，
   把选中态整个盖成灰底；删掉那个单类后，这层冲突就不存在了） */
.filter-card .tag-active {
  color: #fff;
}

/* ---------- 工厂卡片 ---------- */
.factory-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.05);
}

.fi-head { display: flex; align-items: center; }

/* 首字头像：按工厂名 hash 固定配色 */
.fi-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 38rpx;
  font-weight: 600;
  flex: none;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.12);
}

.fi-info { margin-left: 20rpx; flex: 1; min-width: 0; }

.fi-more {
  flex: none;
  margin-left: 12rpx;
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #cbd5e1;
  border-right: 3rpx solid #cbd5e1;
  transform: rotate(45deg);
}

/* 关注星标：卡片右侧竖排小按钮, 未关注灰、已关注琥珀（catchtap 不冒泡到详情跳转） */
.fi-follow {
  flex: none;
  width: 84rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
}

.fi-follow-ic { font-size: 34rpx; line-height: 1.1; }

.fi-follow-tx { font-size: 20rpx; margin-top: 2rpx; }

.fi-follow-on { color: #f59e0b; }

.factory-name {
  font-size: 31rpx;
  font-weight: 600;
  color: #0f172a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.factory-addr { font-size: 24rpx; color: #94a3b8; margin-top: 6rpx; }

.cap-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }

.cap-tag {
  font-size: 22rpx;
  color: #2563eb;
  background: #eff6ff;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

/* 底部操作：电话（主）/ 报价（次）并列；只剩一个按钮时自动整宽 */
.fi-actions { display: flex; gap: 16rpx; margin-top: 22rpx; }
.fi-btn { margin-top: 0; font-size: 26rpx; padding: 14rpx 0; }
.fi-btn-cell { flex: 1; }

.fi-call-tip {
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.6;
  margin-top: 10rpx;
}

/* ---------- F-100 排序条 ---------- */
/* 6 项要一屏放下：按钮文案两字（见 sortOptions）+ 内边距与筛选 chip 同一档，390 屏合计约 325px。
   四字文案时每项多约 25px、总宽 ~650px，只能露到「响应快」的一半，得横向拖 */
.sort-bar { white-space: nowrap; padding: 12rpx 0 18rpx; }

.sort-chip {
  display: inline-block;
  font-size: 24rpx;
  line-height: 1.4;
  color: #475569;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  margin-right: 10rpx;
}

.sort-on { color: #2563eb; background: #eff6ff; border-color: #bfdbfe; }

/* Batch D2：未拿到定位时的「距离最近」（仍可点, 点了引导开定位, 所以只是视觉上淡下去） */
.sort-dim { opacity: 0.45; }

/* F-100：评分/接单量徽标 */
.fi-stats { display: flex; gap: 14rpx; margin-top: 10rpx; }

.fi-stat { font-size: 22rpx; color: #64748b; background: #f1f5f9; border-radius: 999rpx; padding: 4rpx 18rpx; }

.fi-star { color: #d97706; background: #fffbeb; }

/* Batch D2：距离胶囊（与评分/接单量同一行, 用青绿与信任徽章区分） */
.fi-dist { color: #0f766e; background: #ecfdf5; }

/* 印查查式：已核验 + 产能徽章 */
.fi-trust { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 10rpx; }
.fi-verified { font-size: 20rpx; color: #1677ff; background: #e8f4ff; border-radius: 999rpx; padding: 4rpx 16rpx; }
.fi-cap { font-size: 20rpx; border-radius: 999rpx; padding: 4rpx 16rpx; }
.fi-cap-idle { color: #16a34a; background: #e7f7ee; }
.fi-cap-normal { color: #2563eb; background: #eff6ff; }
.fi-cap-busy { color: #dc2626; background: #fef2f2; }

/* F-97/98：加载态与空状态（空文案在 wxml）。
   覆盖全局 .empty（60rpx 0 / 26rpx）：这页的空状态是图标 + 一两行文案，要更松的留白和行高，
   居中与字色沿用全局，这里不再重复声明 */
.empty { padding: 80rpx 40rpx; font-size: 27rpx; line-height: 1.7; }

/* 覆盖全局的 80rpx：加载中的 ⏳ 只是过场，压小一档不抢眼；display/margin 沿用全局 */
.empty-icon { font-size: 70rpx; }

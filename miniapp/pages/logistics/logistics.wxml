<!-- 自定义导航栏（带返回按钮，与全站子页面统一） -->
<view class="navbar" style="padding-top: {{statusBarHeight}}px;">
  <view class="navbar-inner" style="height: {{navBarHeight}}px;">
    <view class="navbar-back" bindtap="goBack">‹</view>
    <view class="navbar-title">物流详情</view>
  </view>
</view>

<view class="page">

  <!-- 发货信息卡 -->
  <view class="card" wx:if="{{logistics}}">
    <view class="card-title">发货信息</view>
    <view class="lg-status st-{{logistics.status}}">{{statusText}}</view>
    <view class="info-row">
      <text class="info-label">订单号</text>
      <text class="info-value">{{orderNo}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">快递公司</text>
      <text class="info-value">{{logistics.expressCompanyName}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">快递单号</text>
      <text class="info-value info-no">{{logistics.express_no}}</text>
      <text class="copy-btn" catchtap="copyExpressNo">复制</text>
    </view>
    <view class="info-row">
      <text class="info-label">发货时间</text>
      <text class="info-value">{{shipTimeText}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">收件人</text>
      <text class="info-value">{{logistics.receiver_name}} {{logistics.receiver_phone}}</text>
    </view>
    <view class="info-addr" wx:if="{{logistics.receiver_address}}">{{logistics.receiver_address}}</view>
  </view>

  <!-- 未发货空态 -->
  <view class="empty" wx:elif="{{!loading && !logistics}}">
    <view class="empty-ic"><view class="ic ic-box"><view class="ic-a"></view></view></view>
    商家尚未发货，发货后可查看物流
  </view>

  <!-- 物流轨迹 -->
  <view class="card" wx:if="{{logistics}}">
    <view class="card-title">物流轨迹</view>

    <!-- 快递100 未配置：降级提示，仅展示发货信息 -->
    <view class="track-tip" wx:if="{{!configured}}">
      🔧 物流查询未配置（快递100 KEY），暂无法自动同步轨迹；可复制单号到快递公司官网查询
    </view>

    <view class="empty" wx:elif="{{!traces.length}}">
      <view class="empty-ic"><view class="ic ic-box"><view class="ic-a"></view></view></view>
      暂无轨迹信息，稍后再来看看
    </view>

    <!-- 时间轴：traces[0] 为最新节点（快递100 倒序返回） -->
    <view class="track-list" wx:else>
      <view class="track-item {{index === 0 ? 'track-first' : ''}} {{logistics.status === 'signed' && index === 0 ? 'track-signed' : ''}}"
            wx:for="{{traces}}" wx:key="index">
        <view class="track-rail">
          <view class="track-dot"></view>
          <view class="track-line" wx:if="{{index < traces.length - 1}}"></view>
        </view>
        <view class="track-body">
          <view class="track-ctx">{{item.context}}</view>
          <view class="track-time">{{item.time}}</view>
        </view>
      </view>
    </view>
  </view>

</view>

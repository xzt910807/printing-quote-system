<view class="navbar" style="padding-top: {{statusBarHeight}}px;">
  <view class="navbar-inner" style="height: {{navBarHeight}}px;">
    <view class="navbar-back" bindtap="goBack">‹</view>
    <view class="navbar-title">沟通消息<text class="navbar-sub" wx:if="{{unread}}">{{unread}} 条未读</text></view>
  </view>
</view>

<view class="page page-tab" style="padding-top: {{statusBarHeight + navBarHeight + 10}}px;">
  <view class="empty" wx:if="{{loading}}">
    <text class="empty-icon">⏳</text>加载中...
  </view>
  <view class="empty" wx:elif="{{!list.length}}">
    <view class="empty-ic"><view class="ic ic-chat"><view class="ic-a"></view></view></view>
    {{isFactory ? '暂无会话，处理询价时可与客户在线沟通' : '暂无会话，在「我的询价」里点在线沟通即可发起'}}
  </view>

  <!-- 会话卡：行1 对家名+时间, 行2 询价单号, 行3 最后消息; 未读角标挂头像右上角(微信式) -->
  <view class="th-card" wx:for="{{list}}" wx:key="inquiryId"
        data-inquiry-id="{{item.inquiryId}}" data-factory-id="{{item.factoryId}}"
        data-name="{{item.showName}}" data-no="{{item.inquiryNo}}" bindtap="openThread">
    <view class="th-avatar-wrap">
      <!-- 首字头像：与找厂工厂卡同款配色（utils/avatar） -->
      <view class="th-avatar" style="background: {{item.avatarColor}}">{{item.avatarText}}</view>
      <text class="th-badge" wx:if="{{item.unread}}">{{item.unread > 99 ? '99+' : item.unread}}</text>
    </view>
    <view class="th-main">
      <view class="th-row">
        <text class="th-name">{{item.showName}}</text>
        <text class="th-time">{{item.lastTimeText}}</text>
      </view>
      <view class="th-sub">{{item.inquiryNo}}{{isFactory && item.quantity ? ' · ' + item.quantity + '个' : ''}}</view>
      <view class="th-last">{{item.lastMessage || '暂无消息'}}</view>
    </view>
  </view>
  <view class="list-end" wx:if="{{loadingMore}}">加载中…</view>
  <view class="list-end" wx:elif="{{list.length && !hasMore}}">— 已加载全部 —</view>
</view>

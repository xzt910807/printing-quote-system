/* 沟通会话列表（印查查式 IM 入口） */
page { background: #f5f5f5; }

.navbar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 10;
  background: #fff;
  border-bottom: 1rpx solid #e2e8f0;
}
.navbar-inner { position: relative; display: flex; align-items: center; justify-content: center; }
.navbar-back {
  position: absolute;
  left: 24rpx;
  bottom: 16rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 44rpx;
  color: #0f172a;
  border-radius: 50%;
  background: rgba(241, 245, 249, 0.9);
}
.navbar-title { font-size: 32rpx; font-weight: 600; color: #0f172a; }
.navbar-sub { margin-left: 12rpx; font-size: 22rpx; color: #dc2626; font-weight: 400; }

.page { padding: 20rpx 24rpx 40rpx; }
.empty { text-align: center; color: #94a3b8; font-size: 26rpx; padding: 100rpx 40rpx; }
.empty-icon { display: block; margin-bottom: 12rpx; }
.empty-ic { display: flex; justify-content: center; margin-bottom: 16rpx; }

.th-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
}
/* 头像包层：未读角标挂右上角（微信式） */
.th-avatar-wrap { position: relative; flex: none; margin-right: 20rpx; }
.th-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 对家名 hash 配色：同厂恒同色, 避免整排同蓝无区分度 */
.th-av-blue { background: #2563eb; }
.th-av-orange { background: #ea580c; }
.th-av-green { background: #059669; }
.th-av-purple { background: #7c3aed; }
.th-av-cyan { background: #0891b2; }
.th-badge {
  position: absolute;
  top: -8rpx;
  right: -10rpx;
  min-width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #dc2626;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  border: 3rpx solid #fff;
  box-sizing: content-box;
}
.th-main { flex: 1; min-width: 0; }
.th-row { display: flex; align-items: center; }
.th-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.th-time { flex: none; margin-left: 16rpx; font-size: 22rpx; color: #94a3b8; }
/* 预览行：询价单号(浅灰) · 最后消息(slate), 单行省略 */
.th-last {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #64748b;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.th-last-no { color: #94a3b8; font-size: 23rpx; }
.th-last-sep { color: #cbd5e1; margin: 0 10rpx; }
.th-last-msg { color: #475569; }

/* 分页脚注：与「我的」页同风格 */
.list-end { text-align: center; font-size: 23rpx; color: #94a3b8; padding: 8rpx 0 40rpx; }

/* ---------- 工厂 Hero 卡（头像 + 厂名 + 待办摘要, 整卡可点 = 进工厂设置） ----------
   头部只承载身份信息, 不放操作按钮（沟通入口在搜索框右侧）；内部编号不对用户展示 */
.factory-hero { display: flex; align-items: center; }

.factory-hero-hover { opacity: 0.9; }

/* 首字头像：白底 + 按厂名 hash 配色（utils/avatar, 与找厂列表/工厂主页同一套） */
.factory-avatar {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.12);
}

.factory-main { flex: 1; min-width: 0; }

/* 厂名单行截断（高度由两行文字撑起, 不再是一条窄条） */
.factory-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 待办摘要：待处理询价 / 未读消息, 让头部有信息量而不只是一行标题 */
.factory-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
}

.factory-arrow {
  flex: none;
  margin-left: 12rpx;
  font-size: 40rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.7);
}

/* ---------- 主 Tab ---------- */
.tabs {
  display: flex;
  background: #fff;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #64748b;
  border-radius: 999rpx;
  position: relative;
}

.tab.active {
  background: linear-gradient(135deg, #4f7cff, #2563eb);
  color: #fff;
  font-weight: 600;
}

.tab-dot {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ef4444;
  margin-left: 10rpx;
  vertical-align: middle;
}

/* ---------- 状态子 Tab ---------- */
.status-tabs {
  display: flex;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.stab {
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  background: #fff;
  font-size: 26rpx;
  color: #64748b;
  border: 2rpx solid transparent;
}

.stab-active {
  background: #eff6ff;
  color: #2563eb;
  font-weight: 500;
  border-color: #93c5fd;
}

.stab-num {
  display: inline-block;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  border-radius: 999rpx;
  background: #ef4444;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  margin-left: 8rpx;
  padding: 0 6rpx;
}

/* ---------- 搜索框 + 沟通入口（搜索框与工单页/我的页同款） ---------- */
/* 沟通入口从头部移到这里：与搜索框同排的圆钮, 头部不再挂操作按钮 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 0 16rpx;
}
.search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 999rpx;
  padding: 0 28rpx;
  height: 72rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.05);
}
.search-icon { display: flex; align-items: center; margin-right: 14rpx; color: #94a3b8; }
.search-input { flex: 1; font-size: 27rpx; color: #0f172a; height: 72rpx; }
.search-ph { color: #94a3b8; font-size: 27rpx; }
.search-clear {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #e2e8f0;
  color: #64748b;
  font-size: 22rpx;
  flex: none;
}

/* 沟通会话入口：与搜索框等高的白底圆钮 + 未读数角标 */
.chat-entry {
  position: relative;
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2563eb;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.05);
}

.chat-entry .ic { transform: scale(0.86); }

.chat-entry-hover { background: #eff6ff; }

.chat-entry-dot {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #ef4444;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  box-sizing: border-box;
}

/* ---------- 卡片 ---------- */
.inquiry-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.05);
}

.inquiry-no { font-size: 24rpx; color: #94a3b8; }

/* 单号可复制：加粗加深 + 按压变蓝 + ⧉ 角标（全局单号统一规范） */
.inquiry-no-copy { font-weight: 600; color: #64748b; letter-spacing: 1rpx; }
.inquiry-no-copy:active { color: #2563eb; }
.copy-ic { font-size: 20rpx; color: #cbd5e1; margin-left: 8rpx; }

.qty { font-size: 28rpx; color: #1e293b; font-weight: 500; }
.type { font-size: 28rpx; color: #334155; }

.time {
  font-size: 22rpx;
  color: #cbd5e1;
  margin-top: 16rpx;
}

/* 询价/订单卡生产参数：浅灰分组面板 + 白底描边标签 + 虚线分隔工艺行 */
.inq-spec {
  margin-top: 16rpx;
  background: #f8fafc;
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
}
.spec-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.spec-tag {
  font-size: 22rpx; color: #334155; line-height: 1.6;
  background: #fff; border: 2rpx solid #e8edf3;
  border-radius: 8rpx; padding: 4rpx 14rpx;
}
.spec-craft {
  margin-top: 12rpx; padding-top: 12rpx;
  border-top: 2rpx dashed #e2e8f0;
  font-size: 22rpx; color: #64748b; line-height: 1.5;
}

/* 询价卡内在线沟通链接（印查查式 IM 入口） */
.inq-chat-link {
  float: right;
  font-size: 24rpx;
  color: #2563eb;
  padding: 0 4rpx;
}

/* 分页脚注（全局列表统一） */
.list-end { text-align: center; font-size: 23rpx; color: #94a3b8; padding: 8rpx 0 40rpx; }

.actions { display: flex; gap: 16rpx; margin-top: 24rpx; }

.btn-flex { flex: 1; }

/* ---------- 登录表单 ---------- */
.login-card { padding: 56rpx 36rpx; text-align: center; }

/* 登录卡顶部图标块：样式在 app.wxss 全局维护（.login-hero-ic），本页不再保留副本 */

.login-title { font-size: 36rpx; font-weight: 700; color: #0f172a; margin: 16rpx 0; }

.login-tip { font-size: 25rpx; color: #94a3b8; margin-bottom: 36rpx; line-height: 1.6; }

.login-input {
  height: 92rpx;
  line-height: 92rpx;
  padding: 0 36rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 999rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
  background: #f8fafc;
  text-align: left;
  box-sizing: border-box;
}

.login-btn { width: 100%; }

/* 021 微信一键登录（绿色主按钮，老板绑定微信场景的第一入口） */
.wx-login-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
}
.wx-login-btn::after { border: none; }
.wx-login-btn[disabled] { background: #86e2ae; color: #fff; }

/* 微信已绑定工厂的一键登录引导：居中灰字一行，弱化不抢视觉 */
.wx-bound-tip {
  margin-top: 22rpx;
  font-size: 24rpx;
  color: #94a3b8;
  text-align: center;
}

/* 021 员工账号登录折叠器：低调文字按钮，展开后显示账号密码表单 */
.staff-toggle {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 27rpx;
  color: #64748b;
  padding: 10rpx 24rpx;
}
.staff-arrow { display: inline-block; transition: transform 0.2s ease; font-size: 24rpx; }
.staff-arrow-up { transform: rotate(180deg); }

/* 员工登录区：绑定微信引导小字 */
.staff-hint {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 18rpx;
  line-height: 1.5;
}

/* 分隔线：「或」 */
.login-divider {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 32rpx 0 16rpx;
  font-size: 24rpx;
  color: #cbd5e1;
}
.login-divider::before,
.login-divider::after {
  content: '';
  flex: 1;
  height: 2rpx;
  background: #e2e8f0;
}

.register-link {
  text-align: center;
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #2563eb;
}

/* ---------- 提示条 ---------- */
.setup-banner {
  background: #fef2f2;
  border: 2rpx solid #fecaca;
  border-radius: 18rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 20rpx;
}

.setup-banner .setup-title { font-size: 29rpx; font-weight: 600; color: #b91c1c; }
.setup-banner .setup-sub { font-size: 24rpx; color: #dc2626; margin-top: 8rpx; line-height: 1.6; }

/* ---------- F-6 验真提示（同行获单率对比）---------- */
.trust-block {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #fff;
  border-radius: 18rpx;
  padding: 20rpx 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.06);
}

.trust-chip {
  flex-shrink: 0;
  font-size: 22rpx;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.trust-on { color: #059669; background: #ecfdf5; }
.trust-off { color: #b45309; background: #fffbeb; }

.trust-tip {
  flex: 1;
  font-size: 23rpx;
  color: #475569;
  line-height: 1.5;
}

.trust-arrow { font-size: 30rpx; color: #cbd5e1; flex-shrink: 0; }

/* ---------- 社区求助（工厂侧） ---------- */
.cr-block {
  background: #fff;
  border-radius: 18rpx;
  padding: 24rpx 26rpx 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.06);
}

.cr-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.cr-title { font-size: 28rpx; font-weight: 600; color: #1e293b; }
.cr-more { font-size: 24rpx; color: #2563eb; }

.cr-item {
  padding: 18rpx 0;
  border-top: 2rpx solid #f1f5f9;
}

.cr-item-hover { background: #f8fafc; }

.cr-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.cr-name {
  flex: 1;
  font-size: 27rpx;
  color: #334155;
  /* 标题限一行，长帖不把卡片顶高 */
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cr-price { font-size: 25rpx; font-weight: 600; color: #dc2626; flex-shrink: 0; }

.cr-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 8rpx;
}

.cr-tag {
  font-size: 21rpx;
  color: #0369a1;
  background: #e0f2fe;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.cr-time { font-size: 21rpx; color: #94a3b8; }

.cr-cap { font-size: 21rpx; color: #b45309; padding: 0 0 14rpx; }

.taken-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #d97706;
  background: #fef3c7;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
}

/* 本厂已报价待客户确认：中性进行态用蓝底, 与「手慢了」的橙底警告分口径 */
.quoted-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #2563eb;
  background: #eff6ff;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
}

.contact-tip {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #047857;
  background: #ecfdf5;
  border-radius: 12rpx;
  padding: 18rpx;
  line-height: 1.7;
}

/* ---------- stage13 发货弹窗 ---------- */
.ship-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  /* 抬高于自定义 tabBar（原生层永远盖在页面 fixed 元素之上），否则底部「取消/确认发货」按钮被 tabBar 遮挡 */
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  background: rgba(15, 23, 42, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.ship-sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  /* 底部留出安全区，全面屏手势条不压「确认发货」按钮 */
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.ship-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  text-align: center;
  margin-bottom: 28rpx;
}

.ship-picker {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1e293b;
  background: #f8fafc;
  box-sizing: border-box;
}

.ship-picker-ph {
  color: #94a3b8;
}

.ship-input {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1e293b;
  background: #f8fafc;
  box-sizing: border-box;
  margin-top: 20rpx;
}

.ship-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.ship-btn {
  flex: 1;
  text-align: center;
}

/* ---------- 确认订单弹窗说明文字 ---------- */
.confirm-tip {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.7;
  margin-bottom: 24rpx;
}

/* ---------- 快递公司大字体选择弹层（原生 picker 字号基础库写死不可样式化，弃用） ---------- */
.comp-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  /* 抬高于发货面板遮罩（z-index:100） */
  z-index: 200;
}

.comp-panel {
  position: fixed;
  left: 0;
  right: 0;
  /* 抬高于自定义 tabBar（原生层恒高于页面 fixed 元素），否则末行快递公司被底栏遮挡 */
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  z-index: 201;
  padding-bottom: env(safe-area-inset-bottom);
  animation: comp-up 0.18s ease-out;
}

@keyframes comp-up {
  from { transform: translateY(60%); opacity: 0.6; }
  to { transform: translateY(0); opacity: 1; }
}

.comp-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.comp-cancel {
  font-size: 30rpx;
  color: #64748b;
  padding: 6rpx 12rpx;
}

.comp-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
}

.comp-confirm {
  font-size: 30rpx;
  font-weight: 600;
  color: #2563eb;
  padding: 6rpx 12rpx;
}

.comp-list {
  /* 可视约 6 行，超出可滑动 */
  max-height: 600rpx;
}

.comp-opt {
  padding: 26rpx 40rpx;
  /* 大字体：原生 picker 滚轮字号过小是本弹层存在的原因 */
  font-size: 34rpx;
  color: #334155;
  text-align: center;
  border-bottom: 2rpx solid #f8fafc;
}

.comp-opt:last-child {
  border-bottom: none;
}

.comp-on {
  color: #2563eb;
  font-weight: 600;
  background: #eff6ff;
}

/* ---------- 021 设计需求（询价卡片） ---------- */
.design-box {
  margin-top: 16rpx;
  background: #f5f3ff;
  border: 2rpx solid #ddd6fe;
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
}

.design-line {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.design-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #6d28d9;
  background: #ede9fe;
  border: 2rpx solid #c4b5fd;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  margin-top: 4rpx;
}

/* 工厂公版徽标：青色系，与需设计（紫）区分 */
.design-badge-public {
  color: #0e7490;
  background: #ecfeff;
  border-color: #a5f3fc;
}

/* 公版单的文字说明跟随青色主题 */
.design-badge-public ~ .design-note {
  color: #155e75;
}

.design-note {
  flex: 1;
  font-size: 24rpx;
  color: #5b21b6;
  line-height: 1.6;
  word-break: break-all;
}

.design-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.design-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  border: 2rpx solid #e9d5ff;
  background: #fff;
}

/* 报价弹窗内设计费说明 */
.design-fee-tip {
  font-size: 24rpx;
  color: #6d28d9;
  background: #f5f3ff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-top: 20rpx;
  line-height: 1.6;
}

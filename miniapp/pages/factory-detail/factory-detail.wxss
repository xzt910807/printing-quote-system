/* 返回按钮 */
.navbar-back {
  position: absolute;
  left: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  /* 热区放大到 88rpx 见方（箭头本身不变）, 避免"看着点到其实没点到" */
  width: 88rpx;
  height: 88rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 44rpx;
  color: #0f172a;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
}

/* 按压态：点击有反馈才能区分"热区没命中"和"逻辑没执行" */
.navbar-back-hover { background: rgba(15, 23, 42, 0.08); }

/* 头部卡片 */
.hero-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 44rpx 28rpx 36rpx;
}

/* 关注：卡右上角收藏按钮（与找厂列表卡角星标同一套语义）, 灰态待关注, 已关注转琥珀 */
.fd-fav {
  position: absolute;
  top: 26rpx;
  right: 20rpx;
  width: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #94a3b8;
}

.fd-fav-ic { font-size: 40rpx; line-height: 1.1; }

.fd-fav-tx { font-size: 20rpx; margin-top: 2rpx; }

.fd-fav-on { color: #f59e0b; }

.fd-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 64rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.15);
}

.fd-title {
  margin-top: 24rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #0f172a;
  text-align: center;
}

.fd-addr {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #64748b;
  background: #f8fafc;
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
}

.fd-copy { color: #2563eb; margin-left: 10rpx; font-size: 24rpx; }

/* 印查查式信任位：徽章 + 产能胶囊 */
.fd-badges { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 16rpx; justify-content: center; }
.fd-verified {
  font-size: 22rpx; color: #1677ff; background: #e8f4ff;
  border-radius: 999rpx; padding: 6rpx 20rpx;
}
.fd-cap { font-size: 22rpx; border-radius: 999rpx; padding: 6rpx 20rpx; }
.fd-cap-idle { color: #16a34a; background: #e7f7ee; }
.fd-cap-normal { color: #2563eb; background: #eff6ff; }
.fd-cap-busy { color: #dc2626; background: #fef2f2; }
.fd-cap-note { margin-top: 12rpx; font-size: 24rpx; color: #64748b; text-align: center; }

/* 信任数据位：评分 + 浏览量 */
.fd-stats { display: flex; gap: 20rpx; margin-top: 14rpx; justify-content: center; }
.fd-stat { font-size: 24rpx; color: #b45309; background: #fff7ed; border-radius: 999rpx; padding: 6rpx 20rpx; }

/* 四段吸顶 tab（与 factory-me 的 .sec-nav 同一套视觉：页面滚动时贴顶） */
.fd-tabs {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.06);
}
.fd-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #64748b;
  padding: 14rpx 0;
  border-radius: 12rpx;
}
.fd-tab:active { background: #f1f5f9; }
.fd-tab-on { background: #eff6ff; color: #2563eb; font-weight: 500; }

/* 经营硬指标（Batch D1）：三列两行，未填报的格显示“—”而不是 0 */
.fd-metrics { display: flex; flex-wrap: wrap; }
.fd-metric {
  width: calc(100% / 3);
  box-sizing: border-box;
  padding: 16rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.fd-metric-val { font-size: 30rpx; font-weight: 600; color: #0f172a; line-height: 1.3; }
.fd-metric-lbl { font-size: 22rpx; color: #94a3b8; margin-top: 6rpx; }
.fd-region { font-size: 24rpx; color: #475569; margin-top: 8rpx; }
.fd-metric-tip { font-size: 20rpx; color: #cbd5e1; margin-top: 12rpx; }

/* 图集分组标题（设备/车间/样品/资质证书） */
.fd-group { margin-bottom: 24rpx; }
.fd-group:last-child { margin-bottom: 0; }
.fd-group-title { font-size: 24rpx; color: #94a3b8; margin-bottom: 12rpx; }

/* 视频段（Batch D3）：无封面时黑底不裂图，下方一行时长 + 说明 */
.fd-video-item { margin-bottom: 24rpx; }
.fd-video-item:last-child { margin-bottom: 0; }
.fd-video { width: 100%; height: 400rpx; border-radius: 12rpx; background: #0f172a; display: block; }
.fd-video-meta { display: flex; align-items: baseline; gap: 16rpx; margin-top: 8rpx; }
.fd-video-dur { font-size: 20rpx; color: #94a3b8; flex: none; }
.fd-video-cap { font-size: 22rpx; color: #64748b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* 设备/车间图文图集 */
.fd-media-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.fd-media-item { width: calc((100% - 32rpx) / 3); }
.fd-media-img { width: 100%; height: 200rpx; border-radius: 12rpx; background: #f1f5f9; display: block; }
.fd-media-cap { font-size: 20rpx; color: #94a3b8; margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* 卡片标题 */
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 20rpx;
}

/* 简介 */
.fd-intro {
  font-size: 27rpx;
  color: #475569;
  line-height: 1.75;
}

/* 联系行 */
.fd-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.fd-label {
  width: 130rpx;
  font-size: 26rpx;
  color: #94a3b8;
  flex: none;
}

.fd-value { flex: 1; font-size: 28rpx; color: #0f172a; }

.fd-call {
  font-size: 24rpx;
  color: #fff;
  background: #16a34a;
  border-radius: 999rpx;
  padding: 8rpx 28rpx;
}

/* 号码下方一句解释（登录可见 / 工厂不接受直拨），比把原因塞进弹窗更像页面的一部分 */
.fd-call-tip {
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.6;
  padding-top: 4rpx;
}

/* 能力块 */
.fd-cap-block { margin-bottom: 24rpx; }
.fd-cap-block:last-child { margin-bottom: 0; }

.fd-cap-label {
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 14rpx;
}

.fd-tags { display: flex; flex-wrap: wrap; gap: 14rpx; }

.fd-tag {
  font-size: 24rpx;
  color: #475569;
  background: #f1f5f9;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
}

.fd-tag-blue { color: #2563eb; background: #eff6ff; }
.fd-tag-green { color: #16a34a; background: #f0fdf4; }

.fd-empty-cap { font-size: 26rpx; color: #94a3b8; text-align: center; padding: 20rpx 0; }

/* 底部操作条（避让 tabBar 由 page-tab 的 padding-bottom 承担） */
.fd-footer {
  margin-top: 8rpx;
  padding-bottom: 20rpx;
}

/* 询价主按钮：整宽, 只在全局 .btn-primary 上加深投影 */
.fd-quote-btn { box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.3); }

/* 返回按钮（自定义导航栏） */
.navbar-back {
  position: absolute;
  left: 24rpx;
  bottom: 16rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 44rpx;
  color: #0f172a;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
}

.page {
  padding: 24rpx;
  box-sizing: border-box;
}

.addr-card {
  margin-bottom: 20rpx;
}

.addr-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.addr-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
}

.addr-phone {
  font-size: 28rpx;
  color: #64748b;
}

.addr-detail {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #334155;
  line-height: 1.5;
}

.addr-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 20rpx;
  border-top: 1rpx solid #f1f5f9;
  padding-top: 16rpx;
}

.addr-btn {
  font-size: 26rpx;
  padding: 8rpx 24rpx;
}

.addr-del {
  color: #dc2626;
}

.addr-add {
  margin-top: 32rpx;
  text-align: center;
}

/* 底部弹层表单 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  box-sizing: border-box;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  text-align: center;
  margin-bottom: 24rpx;
}

.sheet .input {
  margin-bottom: 20rpx;
}

.pca-row {
  display: flex;
  gap: 16rpx;
}

.pca-item {
  flex: 1;
  min-width: 0;
}

/* stage14 省市区联动选择器的摘要显示区（复用 .input 视觉，占位文案置灰） */
.region-display { margin-bottom: 20rpx; }

.region-placeholder { color: #94a3b8; }

.addr-textarea {
  width: 100%;
  height: 140rpx;
  box-sizing: border-box;
}

.default-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 16rpx;
  font-size: 28rpx;
  color: #334155;
}

.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.sheet-btn {
  flex: 1;
  text-align: center;
}

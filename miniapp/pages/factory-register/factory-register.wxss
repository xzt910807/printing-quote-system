/* 返回按钮（自定义导航栏） */
.navbar-back {
  position: absolute;
  left: 24rpx;
  bottom: 16rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 44rpx;
  color: #0f172a;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
}

.form-card { padding: 40rpx 32rpx; }

.form-title { font-size: 36rpx; font-weight: 700; color: #0f172a; margin-bottom: 12rpx; }
.form-tip {
  font-size: 25rpx;
  color: #94a3b8;
  margin-bottom: 36rpx;
  line-height: 1.6;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.field { margin-bottom: 28rpx; }

.field .label {
  display: block;
  font-size: 26rpx;
  color: #475569;
  margin-bottom: 12rpx;
}

.field .req { color: #dc2626; }

.field .textarea {
  min-height: 160rpx;
}

.submit-btn { width: 100%; margin-top: 16rpx; }

/* ---------- 提交成功 ---------- */
.success-card { padding: 80rpx 40rpx; text-align: center; }
.success-icon { font-size: 88rpx; margin-bottom: 24rpx; }
.success-title { font-size: 36rpx; font-weight: 700; color: #0f172a; margin-bottom: 20rpx; }
.success-tip { font-size: 26rpx; color: #64748b; line-height: 1.8; margin-bottom: 12rpx; }
.success-tip .code { color: #2563eb; font-weight: 700; }
.success-card .submit-btn { margin-top: 40rpx; }

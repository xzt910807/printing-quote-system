/* ---------- 021 智能排版工具页 ---------- */

/* 返回按钮（自定义导航栏） */
.navbar-back {
  position: absolute;
  left: 24rpx;
  bottom: 16rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 44rpx;
  color: #0f172a;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
}

/* 顶部方式分段选择：模板排版 / AI 画参考图 互斥 */
.seg {
  display: flex;
  background: #f1f5f9;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 16rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  color: #64748b;
  padding: 16rpx 0;
  border-radius: 12rpx;
}
.seg-on {
  background: #2563eb;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.25);
}

/* 分段下方的当前方式说明 */
.seg-desc {
  font-size: 23rpx;
  color: #94a3b8;
  margin: 0 4rpx 24rpx;
  line-height: 1.5;
}

/* 空态 */
.empty {
  background: #fff;
  border-radius: 24rpx;
  padding: 80rpx 40rpx;
  text-align: center;
}
.empty-title { font-size: 30rpx; font-weight: 600; color: #0f172a; }
.empty-desc { font-size: 26rpx; color: #64748b; margin-top: 16rpx; line-height: 1.7; }
.empty-back { margin: 40rpx auto 0; width: 320rpx; }

/* 模板选择条：横滑缩略图 */
.tpl-scroll { width: 100%; white-space: nowrap; margin-bottom: 24rpx; }

.tpl-row {
  display: inline-flex;
  gap: 20rpx;
  padding: 4rpx 2rpx;
}

.tpl-card {
  flex-shrink: 0;
  background: #fff;
  border: 4rpx solid #e2e8f0;
  border-radius: 18rpx;
  padding: 14rpx;
  text-align: center;
  box-sizing: border-box;
}

.tpl-on {
  border-color: #2563eb;
  box-shadow: 0 4rpx 16rpx rgba(37, 99, 235, 0.18);
}

.tpl-thumb {
  position: relative;
  margin: 0 auto;
  border-radius: 10rpx;
  overflow: hidden;
  border: 2rpx solid #f1f5f9;
  box-sizing: border-box;
}

.tpl-thumb-slot {
  position: absolute;
  max-width: 96%;
  white-space: nowrap;
  overflow: hidden;
  color: rgba(100, 116, 139, 0.55);
  line-height: 1.2;
}

.tpl-name {
  width: 150rpx;
  margin: 12rpx auto 0;
  font-size: 22rpx;
  color: #475569;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.tpl-on .tpl-name { color: #2563eb; font-weight: 600; }

/* 缩略图里的装饰线 */
.tpl-thumb-line {
  position: absolute;
  transform: translateX(-50%);
  border-radius: 999rpx;
}

/* 实时预览 */
.preview-card { margin-bottom: 24rpx; }

.preview-wrap {
  position: relative;
  width: 620rpx;
  margin: 0 auto;
  border-radius: 12rpx;
  overflow: hidden;
  border: 2rpx solid #e2e8f0;
  box-sizing: border-box;
}

.preview-slot {
  position: absolute;
  /* inline-block：宽度随内容，translateX(-50%) 才真正相对文字自身居中；
     block 会撑满整行，导致 translateX(-50%) 偏移整行宽、文字偏左 */
  display: inline-block;
  max-width: 96%;
  white-space: nowrap;
  overflow: hidden;
  line-height: 1.25;
  font-weight: 600;
  text-shadow: 0 0 2rpx rgba(255, 255, 255, 0.35);
}

/* 模板装饰线（分隔标题区，绝对定位细条） */
.preview-line {
  position: absolute;
  transform: translateX(-50%);
  border-radius: 999rpx;
}

.preview-placeholder {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 26rpx;
  color: #94a3b8;
}

.preview-hint {
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 18rpx;
}

/* 文字表单 */
.form-card { margin-bottom: 24rpx; }

.slot-item { padding: 22rpx 0; border-bottom: 2rpx solid #f1f5f9; }
.slot-item:last-of-type { border-bottom: none; }

.slot-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.slot-label { font-size: 28rpx; color: #334155; font-weight: 600; }

.slot-required {
  font-size: 20rpx;
  color: #dc2626;
  background: #fef2f2;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-left: 12rpx;
  vertical-align: 4rpx;
}

.slot-max { font-size: 22rpx; color: #94a3b8; }

.slot-input {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 22rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1e293b;
  box-sizing: border-box;
}

.gen-btn { margin-top: 28rpx; }
.gen-btn.disabled { opacity: 0.55; }

/* 生成结果 */
.result-card { margin-bottom: 24rpx; }

.result-img {
  width: 100%;
  border-radius: 12rpx;
  border: 2rpx solid #e2e8f0;
  display: block;
  box-sizing: border-box;
}

.result-note {
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 16rpx;
  /* 说明文案固定一行，杜绝折行参差 */
  white-space: nowrap;
}

.result-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
  align-items: stretch;
}

/* 结果区两个按钮统一规格：同高同字号、文字水平垂直居中（全局 btn-ghost 比 btn-primary 小一圈，并排错位） */
.result-actions .btn-ghost,
.result-actions .btn-primary {
  flex: 1;
  height: 92rpx;
  padding: 0;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.result-actions .btn-ghost {
  background: #f8fafc;
  color: #334155;
  border: 2rpx solid #e2e8f0;
}

.footnote {
  text-align: center;
  font-size: 20rpx;
  color: #94a3b8;
  padding: 12rpx 0 40rpx;
  line-height: 1.7;
  /* 底部说明固定一行：文案已精简到单行容量，配合 nowrap 杜绝折行 */
  white-space: nowrap;
}

/* ---------- 021-b AI 生成参考图 ---------- */
.ai-card { margin-bottom: 24rpx; }

.ai-title { display: flex; align-items: center; gap: 14rpx; }

.ai-tag {
  font-size: 20rpx;
  color: #7c3aed;
  background: #f5f3ff;
  border: 2rpx solid #ddd6fe;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  font-weight: 400;
}

.ai-desc {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
  margin: 14rpx 0 18rpx;
}

.ai-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx 22rpx 84rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1e293b;
  line-height: 1.5;
  box-sizing: border-box;
}

/* 语音描述（话筒内嵌输入框右下角，紫色主题；catchtouch 不抢 textarea 焦点） */
.ai-input-wrap { position: relative; }

.ai-mic {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f5f3ff;
  border: 2rpx solid #ddd6fe;
  color: #7c3aed;
  display: flex;
  align-items: center;
  justify-content: center;
  user-select: none;
}

.ai-mic-on {
  background: #7c3aed;
  border-color: #7c3aed;
  color: #fff;
  transform: scale(1.08);
}

.ai-input-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
  padding: 0 6rpx;
}

.ai-meta-hint { font-size: 22rpx; color: #94a3b8; }
.ai-meta-hint.recording { color: #dc2626; }
.ai-meta-count { font-size: 22rpx; color: #cbd5e1; }

.ai-actions { margin-top: 20rpx; }
.ai-gen-btn.disabled { opacity: 0.55; }

.ai-result-img {
  width: 100%;
  border-radius: 12rpx;
  border: 2rpx solid #e2e8f0;
  display: block;
  margin-top: 24rpx;
  box-sizing: border-box;
}

.ai-divider {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 8rpx 0 24rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.ai-divider::before,
.ai-divider::after {
  content: '';
  flex: 1;
  height: 2rpx;
  background: #e2e8f0;
}


/* 询价会话聊天页（印查查式 IM） */
page { background: #f1f5f9; }

.navbar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 10;
  background: #fff;
  border-bottom: 1rpx solid #e2e8f0;
}
.navbar-inner { position: relative; display: flex; align-items: center; justify-content: center; }
.navbar-back {
  position: absolute;
  left: 24rpx;
  bottom: 16rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 44rpx;
  color: #0f172a;
  border-radius: 50%;
  background: rgba(241, 245, 249, 0.9);
}
.navbar-title {
  /* 全局 .navbar-inner 已有 padding: 0 200rpx 避让胶囊, 这里不能再叠 60% 限宽
     （两者相乘只剩 210rpx, 12 字厂名会被截成「浙江博润印 …」） */
  max-width: 100%;
  font-size: 32rpx;
  font-weight: 400;
  color: #0f172a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.navbar-sub { font-size: 22rpx; color: #94a3b8; font-weight: 400; }

/* 消息区：介于导航栏与输入栏之间 */
.msg-area { position: fixed; left: 0; right: 0; padding: 20rpx 24rpx; box-sizing: border-box; }
.msg-empty { text-align: center; color: #94a3b8; font-size: 26rpx; padding: 80rpx 40rpx; }
.msg-quick { margin-top: 20rpx; font-size: 22rpx; color: #cbd5e1; line-height: 1.7; }

.msg-item { display: flex; align-items: flex-start; margin-bottom: 24rpx; }
.msg-item.msg-mine { justify-content: flex-end; }

/* 双方头像：气泡直接贴屏幕边会让对话"没有人", 68rpx 圆形, 底色复用 utils/avatar 的名称 hash */
.msg-avatar {
  flex: none;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  box-shadow: 0 2rpx 6rpx rgba(15, 23, 42, 0.08);
}
.msg-avatar-txt {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
.msg-peer .msg-avatar { margin-right: 16rpx; }
.msg-mine .msg-avatar { margin-left: 16rpx; }

.msg-bubble {
  max-width: 76%;
  background: #fff;
  border-radius: 18rpx 18rpx 18rpx 4rpx;
  padding: 18rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.05);
}
.msg-mine .msg-bubble {
  background: #2563eb;
  border-radius: 18rpx 18rpx 4rpx 18rpx;
}
.msg-text {
  display: block;
  font-size: 28rpx;
  color: #0f172a;
  line-height: 1.6;
  /* 不能用 break-all：会把「12天」「871C」这类数字串从中间拆行（曾出现"确认稿后1 / 2天交付"）；
     normal 保证中英数混排按词自然断, 超长连续 ASCII（URL/文件名）交给 overflow-wrap 兜底 */
  word-break: normal;
  overflow-wrap: break-word;
  white-space: pre-wrap;
}
.msg-mine .msg-text { color: #fff; }

/* 文件消息：在消息流里就是一张名片/一张缩图, 不再是一行“[文件] xxx”文本 */
.msg-bubble-file { padding: 0; overflow: hidden; }
.msg-file-img {
  display: block;
  width: 320rpx;
  height: 320rpx;
  background: #f1f5f9;
}
.msg-file-card { display: flex; align-items: center; padding: 20rpx 24rpx; }
/* 格式标直接写扩展名：PDF/CDR 比任何文件图标都信息量大, 也不再引一个 emoji */
.msg-file-ic {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-right: 18rpx;
  border-radius: 12rpx;
  background: rgba(37, 99, 235, 0.10);
  color: #2563eb;
  font-size: 20rpx;
  font-weight: 700;
}
.msg-file-info { display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.msg-file-name {
  max-width: 360rpx;
  font-size: 26rpx;
  color: #0f172a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.msg-file-size { font-size: 22rpx; color: #94a3b8; }
/* 我方蓝底气泡：色块与文字改半透明白, 蓝字压蓝块会糊成一团 */
.msg-mine .msg-file-ic { background: rgba(255, 255, 255, 0.22); color: #fff; }
.msg-mine .msg-file-name { color: #fff; }
.msg-mine .msg-file-size { color: rgba(255, 255, 255, 0.72); }
/* 微信式居中时间分隔线（仅间隔超 5 分钟时出现） */
.msg-divider {
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  margin: 4rpx 0 20rpx;
}

/* 底部输入栏 */
.input-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: 56px;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: content-box;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  background: #fff;
  border-top: 1rpx solid #e2e8f0;
}
.msg-input {
  flex: 1;
  height: 72rpx;
  background: #f1f5f9;
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}
.msg-ph { color: #94a3b8; }
.msg-send {
  flex: none;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #2563eb;
  color: #fff;
  font-size: 28rpx;
}
.msg-send-off { opacity: 0.4; }


/* 026 附件按钮（文件本身已经是消息流里的一条, 不再做底部汇总面板） */
.msg-attach {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 50%;
  background: #f1f5f9;
  color: #475569;
  font-size: 34rpx;
}

/* ===== 顶部实时单据胶囊 + 展开面板 =====
   原本聊天页只有一条光秃秃的消息流, 双方都不知道在谈哪一单; 单据信息常驻顶部且每次现取（改价后价格立刻跟着变）。
   做成左右留白的悬浮胶囊而不是通栏白条：通栏白条与白色导航栏同色同边, 会被读成导航栏的第二行 */
.ctx-bar {
  position: fixed;
  top: 0; left: 24rpx; right: 24rpx;
  z-index: 9;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 12rpx 0 24rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.08);
}
/* 状态圆点替代色块 chip：只给「该行动」上颜色, 其余中性, 价格才是唯一焦点 */
.ctx-dot { flex: none; width: 12rpx; height: 12rpx; border-radius: 50%; background: #cbd5e1; }
.ctx-dot-hot { background: #f97316; box-shadow: 0 0 0 6rpx rgba(249, 115, 22, 0.14); }
.ctx-dot-wait { background: #3b82f6; }
.ctx-dot-done { background: #16a34a; }
.ctx-dot-off { background: #cbd5e1; }
.ctx-sta { flex: none; font-size: 25rpx; color: #475569; }
.ctx-right { margin-left: auto; display: flex; align-items: center; gap: 16rpx; min-width: 0; }
.ctx-price { font-size: 30rpx; font-weight: 700; color: #ea580c; }
.ctx-price-sys { font-size: 24rpx; font-weight: 400; color: #94a3b8; }
.ctx-more { flex: none; display: flex; align-items: center; gap: 8rpx; padding-left: 16rpx; border-left: 1rpx solid #eef2f7; }
.ctx-more-t { font-size: 23rpx; color: #94a3b8; }
/* 箭头用边框拼而不写 ▲▼ 字符：字符在小程序里基线发虚, 且展开/收起两个三角大小不一致 */
.ctx-caret {
  width: 12rpx;
  height: 12rpx;
  border-right: 2rpx solid #94a3b8;
  border-bottom: 2rpx solid #94a3b8;
  transform: rotate(45deg);
  margin-top: -6rpx;
}
.ctx-caret-up { transform: rotate(-135deg); margin-top: 6rpx; }

.ctx-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 12;
  background: rgba(15, 23, 42, 0.35);
}
.ctx-panel {
  position: fixed;
  left: 24rpx; right: 24rpx;
  z-index: 13;
  max-height: 60vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 20rpx;
  padding: 8rpx 28rpx 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.14);
}
.ctx-line {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f8fafc;
}
/* 单号行可点复制（单号从胶囊移进面板后, 这里就是它唯一的落点） */
.ctx-line-copy { margin: 0 -12rpx; padding-left: 12rpx; padding-right: 12rpx; border-radius: 10rpx; }
.ctx-line-copy:active { background: #f8fafc; }
.ctx-copy { flex: none; font-size: 22rpx; color: #2563eb; }
.ctx-k { flex: none; width: 132rpx; font-size: 24rpx; color: #94a3b8; }
.ctx-v {
  flex: 1;
  font-size: 25rpx;
  color: #0f172a;
  line-height: 1.5;
  /* 与消息气泡同理: break-all 会把尺寸/单号这类数字串从中间拆行 */
  word-break: normal;
  overflow-wrap: break-word;
}
.ctx-tags { flex: 1; display: flex; flex-wrap: wrap; gap: 8rpx; }
.ctx-tag { font-size: 22rpx; color: #475569; background: #f1f5f9; border-radius: 6rpx; padding: 4rpx 12rpx; }
.ctx-pv { flex: 1; display: flex; align-items: baseline; gap: 12rpx; }
.ctx-old { font-size: 24rpx; color: #cbd5e1; text-decoration: line-through; }
.ctx-now { font-size: 30rpx; font-weight: 600; color: #ea580c; }
.ctx-rev { font-size: 20rpx; color: #16a34a; background: #f0fdf4; border-radius: 6rpx; padding: 2rpx 10rpx; }
.ctx-exp { color: #b45309; }
.ctx-acts { display: flex; gap: 16rpx; margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #f1f5f9; }
.ctx-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 27rpx;
  color: #475569;
  background: #f1f5f9;
}
.ctx-btn-primary { color: #fff; background: #2563eb; }
.ctx-btn:active { opacity: 0.85; }

/* 系统留痕（工厂改价等）：居中灰字小条, 与双方左右气泡在视觉上分层 */
.msg-sys {
  max-width: 82%;
  margin: 0 auto 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
  background: rgba(226, 232, 240, 0.55);
  text-align: center;
  font-size: 22rpx;
  line-height: 1.6;
  color: #64748b;
}

/* 工厂就地改价弹层：与接单页报价弹窗同款形态, 样式独立一份避免跨页耦合 */
.rq-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.45);
}
.rq-sheet {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}
.rq-title { text-align: center; font-size: 32rpx; font-weight: 600; color: #0f172a; }
.rq-tip {
  margin: 16rpx 0 24rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
}
.rq-input {
  height: 84rpx;
  margin-bottom: 20rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #0f172a;
}
.rq-btns { display: flex; gap: 20rpx; margin-top: 8rpx; }
.rq-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  color: #475569;
  background: #f1f5f9;
}
.rq-btn-primary { color: #fff; background: #2563eb; }
.rq-btn-off { opacity: 0.5; }

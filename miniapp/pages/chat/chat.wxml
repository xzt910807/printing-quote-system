<view class="navbar" style="padding-top: {{statusBarHeight}}px;">
  <view class="navbar-inner" style="height: {{navBarHeight}}px;">
    <view class="navbar-back" bindtap="goBack">‹</view>
    <view class="navbar-title">{{title}}<text class="navbar-sub" wx:if="{{subTip}}"> · {{subTip}}</text></view>
  </view>
</view>

<!-- 顶部实时单据胶囊：解决「聊了半天对方不知道在说哪一单」; 单号已在导航栏副标题, 这里不重复占位 -->
<view class="ctx-bar" wx:if="{{ctx}}" style="top: {{statusBarHeight + navBarHeight + ctxGap}}px; height: {{ctxBarH}}px;" bindtap="toggleCtx">
  <view class="ctx-dot ctx-dot-{{ctx.dotClass}}"></view>
  <text class="ctx-sta">{{ctx.shortText || ctx.statusText}}</text>
  <view class="ctx-right">
    <text class="ctx-price" wx:if="{{ctx.factoryPrice}}">¥{{ctx.factoryPrice}}</text>
    <text class="ctx-price ctx-price-sys" wx:elif="{{ctx.systemPrice}}">参考价 ¥{{ctx.systemPrice}}</text>
    <view class="ctx-more">
      <text class="ctx-more-t">{{ctxOpen ? '收起' : '单据明细'}}</text>
      <view class="ctx-caret {{ctxOpen ? 'ctx-caret-up' : ''}}"></view>
    </view>
  </view>
</view>

<view class="ctx-mask" wx:if="{{ctxOpen}}" bindtap="toggleCtx"></view>
<view class="ctx-panel" wx:if="{{ctxOpen}}" style="top: {{statusBarHeight + navBarHeight + ctxBarH + ctxGap * 2}}px;">
  <view class="ctx-line ctx-line-copy" data-no="{{ctx.inquiryNo}}" bindtap="copyInquiryNo">
    <text class="ctx-k">询价单号</text><text class="ctx-v">{{ctx.inquiryNo}}</text>
    <text class="ctx-copy">复制</text>
  </view>
  <view class="ctx-line">
    <text class="ctx-k">当前状态</text><text class="ctx-v">{{ctx.statusText}}</text>
  </view>
  <view class="ctx-line">
    <text class="ctx-k">品类数量</text>
    <text class="ctx-v">{{ctx.productText}} · {{ctx.quantity}}件</text>
  </view>
  <view class="ctx-line" wx:if="{{ctx.specTags.length}}">
    <text class="ctx-k">生产参数</text>
    <view class="ctx-tags">
      <text class="ctx-tag" wx:for="{{ctx.specTags}}" wx:for-item="tg" wx:key="*this">{{tg}}</text>
    </view>
  </view>
  <view class="ctx-line" wx:if="{{ctx.processText}}">
    <text class="ctx-k">后道工艺</text><text class="ctx-v">{{ctx.processText}}</text>
  </view>
  <view class="ctx-line" wx:if="{{ctx.systemPrice}}">
    <text class="ctx-k">系统参考价</text><text class="ctx-v">¥{{ctx.systemPrice}}</text>
  </view>
  <view class="ctx-line" wx:if="{{ctx.factoryPrice}}">
    <text class="ctx-k">工厂报价</text>
    <view class="ctx-pv">
      <text class="ctx-old" wx:if="{{ctx.prevPrice && ctx.revision > 1}}">¥{{ctx.prevPrice}}</text>
      <text class="ctx-now">¥{{ctx.factoryPrice}}</text>
      <text class="ctx-rev" wx:if="{{ctx.revisionText}}">{{ctx.revisionText}}</text>
    </view>
  </view>
  <view class="ctx-line" wx:if="{{ctx.designFee}}">
    <text class="ctx-k">其中设计费</text><text class="ctx-v">¥{{ctx.designFee}}</text>
  </view>
  <view class="ctx-line" wx:if="{{ctx.quoteRemark}}">
    <text class="ctx-k">工厂说明</text><text class="ctx-v">{{ctx.quoteRemark}}</text>
  </view>
  <view class="ctx-line" wx:if="{{ctx.quoteExpiresText}}">
    <text class="ctx-k">报价有效期</text>
    <text class="ctx-v {{ctx.quoteExpired ? 'ctx-exp' : ''}}">{{ctx.quoteExpired ? '已于 ' + ctx.quoteExpiresText + ' 过期' : ctx.quoteExpiresText}}</text>
  </view>
  <view class="ctx-line" wx:if="{{ctx.orderNo}}">
    <text class="ctx-k">关联订单</text><text class="ctx-v">{{ctx.orderNo}}{{ctx.orderStatusText ? ' · ' + ctx.orderStatusText : ''}}</text>
  </view>
  <view class="ctx-acts" wx:if="{{ctx.canRequote || (!isFactory && ctx.status === 'factory_quoted' && !ctx.quoteExpired)}}">
    <view class="ctx-btn ctx-btn-primary" wx:if="{{ctx.canRequote}}" catchtap="openRequote">修改报价</view>
    <!-- 聊天页不承载下单：客户只给一个直达确认入口 -->
    <view class="ctx-btn" wx:if="{{!isFactory && ctx.status === 'factory_quoted' && !ctx.quoteExpired}}" catchtap="goConfirmQuote">去确认下单</view>
  </view>
</view>

<scroll-view class="msg-area" scroll-y scroll-into-view="msg-{{lastId}}" scroll-with-animation
             style="top: {{statusBarHeight + navBarHeight + (ctx ? ctxBarH + ctxGap * 2 : 0)}}px; bottom: {{inputBarH + safeBottom + keyboardHeight}}px;">
  <view class="msg-empty" wx:if="{{loading}}">加载中...</view>
  <view class="msg-empty" wx:elif="{{!messages.length}}">
    还没有消息，发一条打个招呼吧
    <view class="msg-quick">常见开场：交期多久？/ 能否接这个量？/ 可以看看效果图吗？</view>
  </view>
  <view wx:for="{{messages}}" wx:key="id">
    <view class="msg-divider" wx:if="{{item.showTime}}">{{item.timeText}}</view>
    <!-- 系统留痕（工厂改价等）：居中灰字, 不带头像与气泡, 与双方对话在视觉上分层 -->
    <view class="msg-sys" wx:if="{{item.system}}">{{item.content}}</view>
    <view wx:else class="msg-item {{item.mine ? 'msg-mine' : 'msg-peer'}}" id="msg-{{item.id}}">
      <!-- 对方头像：对家名称 hash 首字（工厂视角下对家是客户, 同样取名字首字） -->
      <view wx:if="{{!item.mine}}" class="msg-avatar msg-avatar-txt" style="background: {{peerAvatarColor}}">{{peerAvatarText}}</view>
      <view class="msg-bubble">
        <text class="msg-text">{{item.content}}</text>
      </view>
      <!-- 我方头像：C 端优先真实头像, 工厂端与无头像时用首字 -->
      <block wx:if="{{item.mine}}">
        <image wx:if="{{myAvatarFull}}" class="msg-avatar" src="{{myAvatarFull}}" mode="aspectFill" />
        <view wx:else class="msg-avatar msg-avatar-txt" style="background: {{myAvatarColor}}">{{myAvatarText}}</view>
      </block>
    </view>
  </view>
</scroll-view>

<view class="input-bar" style="bottom: {{keyboardHeight}}px;">
  <view class="msg-attach" bindtap="chooseFile">📎</view>
  <input class="msg-input" value="{{inputText}}" placeholder="输入消息（最长 500 字）" placeholder-class="msg-ph"
         confirm-type="send" cursor-spacing="16" adjust-position="{{false}}"
         bindinput="onInput" bindfocus="onFocus" bindblur="onBlur" bindconfirm="send" />
  <view class="msg-send {{!inputText || sending ? 'msg-send-off' : ''}}" bindtap="send">发送</view>
</view>

<!-- 工厂就地改价弹层：议价谈完当场改, 预填当前价（在旧数上改不是从零重填） -->
<view class="rq-mask" wx:if="{{rq.show}}" bindtap="closeRequote">
  <view class="rq-sheet" catchtap="noop">
    <view class="rq-title">修改报价 {{ctx.inquiryNo}}</view>
    <view class="rq-tip">当前报价 ¥{{ctx.factoryPrice}}{{ctx.revisionText ? '（' + ctx.revisionText + '）' : ''}}。改价后客户会收到站内信，会话里自动留一条调价记录。</view>
    <input class="rq-input" type="digit" placeholder="新报价金额（元）" value="{{rq.price}}" bindinput="onRqPriceInput" />
    <input class="rq-input" type="number" placeholder="报价有效期（天，默认 7 天）" value="{{rq.validDays}}" bindinput="onRqDaysInput" />
    <input class="rq-input" placeholder="调价说明（选填，如：量大可让利）" value="{{rq.remark}}" bindinput="onRqRemarkInput" />
    <view class="rq-btns">
      <view class="rq-btn" bindtap="closeRequote">取消</view>
      <view class="rq-btn rq-btn-primary {{rq.submitting ? 'rq-btn-off' : ''}}" catchtap="submitRequote">提交改价</view>
    </view>
  </view>
</view>

<!-- 026 协同文件列表（当前会话相关的设计源文件） -->
<view class="file-panel" wx:if="{{files.length}}" style="bottom: {{keyboardHeight + inputBarH + safeBottom}}px;">
  <view class="file-panel-hd" bindtap="toggleFiles">
    <text>会话文件 ({{files.length}})</text>
    <view class="file-caret-wrap">
      <text class="file-toggle-t">{{filesExpanded ? '收起' : '展开'}}</text>
      <view class="ctx-caret {{filesExpanded ? 'ctx-caret-up' : ''}}"></view>
    </view>
  </view>
  <view class="file-list" wx:if="{{filesExpanded}}">
    <view class="file-row" wx:for="{{files}}" wx:key="id" data-url="{{item.fullUrl}}" data-image="{{item.isImage}}" bindtap="openFile">
      <image wx:if="{{item.isImage}}" class="file-thumb" src="{{item.fullUrl}}" mode="aspectFill" lazy-load />
      <text class="file-name">{{item.file_name}}</text>
      <text class="file-meta">{{item.senderText}} · {{item.sizeText}}</text>
      <view class="file-open"></view>
    </view>
  </view>
</view>

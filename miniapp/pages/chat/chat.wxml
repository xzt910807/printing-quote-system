<view class="navbar" style="padding-top: {{statusBarHeight}}px;">
  <view class="navbar-inner" style="height: {{navBarHeight}}px;">
    <view class="navbar-back" bindtap="goBack">‹</view>
    <view class="navbar-title">{{title}}<text class="navbar-sub" wx:if="{{subTip}}"> · {{subTip}}</text></view>
  </view>
</view>

<scroll-view class="msg-area" scroll-y scroll-into-view="msg-{{lastId}}" scroll-with-animation
             style="top: {{statusBarHeight + navBarHeight}}px; bottom: {{inputBarH + keyboardHeight}}px;">
  <view class="msg-empty" wx:if="{{loading}}">加载中...</view>
  <view class="msg-empty" wx:elif="{{!messages.length}}">
    还没有消息，发一条打个招呼吧
    <view class="msg-quick">常见开场：交期多久？/ 能否接这个量？/ 可以看看效果图吗？</view>
  </view>
  <view wx:for="{{messages}}" wx:key="id">
    <view class="msg-divider" wx:if="{{item.showTime}}">{{item.timeText}}</view>
    <view class="msg-item {{item.mine ? 'msg-mine' : 'msg-peer'}}" id="msg-{{item.id}}">
      <!-- 对方头像：对家名称 hash 首字（工厂视角下对家是客户, 同样取名字首字） -->
      <view wx:if="{{!item.mine}}" class="msg-avatar msg-avatar-txt" style="background: {{peerAvatarColor}}">{{peerAvatarText}}</view>
      <view class="msg-bubble">
        <text class="msg-text">{{item.content}}</text>
      </view>
      <!-- 我方头像：C 端优先真实头像, 工厂端与无头像时用首字 -->
      <block wx:if="{{item.mine}}">
        <image wx:if="{{myAvatarFull}}" class="msg-avatar" src="{{myAvatarFull}}" mode="aspectFill" />
        <view wx:else class="msg-avatar msg-avatar-txt" style="background: {{myAvatarColor}}">{{myAvatarText}}</view>
      </block>
    </view>
  </view>
</scroll-view>

<view class="input-bar" style="bottom: {{keyboardHeight}}px;">
  <view class="msg-attach" bindtap="chooseFile">📎</view>
  <input class="msg-input" value="{{inputText}}" placeholder="输入消息（最长 500 字）" placeholder-class="msg-ph"
         confirm-type="send" cursor-spacing="16" adjust-position="{{false}}"
         bindinput="onInput" bindfocus="onFocus" bindblur="onBlur" bindconfirm="send" />
  <view class="msg-send {{!inputText || sending ? 'msg-send-off' : ''}}" bindtap="send">发送</view>
</view>

<!-- 026 协同文件列表（当前会话相关的设计源文件） -->
<view class="file-panel" wx:if="{{files.length}}" style="bottom: {{keyboardHeight + inputBarH}}px;">
  <view class="file-panel-hd" bindtap="toggleFiles">
    <text>会话文件 ({{files.length}})</text>
    <text class="file-toggle">{{filesExpanded ? '▲' : '▼'}}</text>
  </view>
  <view class="file-list" wx:if="{{filesExpanded}}">
    <view class="file-row" wx:for="{{files}}" wx:key="id" data-url="{{item.fullUrl}}" data-name="{{item.file_name}}" bindtap="openFile">
      <text class="file-name">{{item.file_name}}</text>
      <text class="file-meta">{{item.senderText}} · {{item.sizeText}}</text>
    </view>
  </view>
</view>

/* D4 社区列表页 */
.navbar { position: fixed; top: 0; left: 0; right: 0; background: #fff; z-index: 100; box-shadow: 0 1px 4px rgba(0,0,0,.05); }
.navbar-inner { display: flex; align-items: center; justify-content: center; position: relative; }
.navbar-title { text-align: center; font-size: 32rpx; font-weight: 400; color: #0f172a; }
/* 「我的」贴右上角（与找厂页返回键同位置逻辑：绝对定位不占中部标题的位） */
.navbar-mine {
  position: absolute;
  right: 24rpx;
  bottom: 16rpx;
  font-size: 26rpx;
  color: #2563eb;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #eff6ff;
}

.cat-bar { white-space: nowrap; background: #fff; border-radius: 12rpx; padding: 12rpx; margin-bottom: 16rpx; }
.cat-chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 12rpx;
  border-radius: 30rpx;
  background: #f2f3f5;
  color: #666;
  font-size: 26rpx;
}
.cat-on { background: #2563eb; color: #fff; }

.sort-row { display: flex; align-items: center; background: #fff; border-radius: 12rpx; padding: 12rpx 16rpx; margin-bottom: 16rpx; }
.sort-chip { font-size: 25rpx; color: #64748b; padding: 8rpx 24rpx; margin-right: 10rpx; border-radius: 999rpx; }
.sort-on { color: #2563eb; background: #eff6ff; font-weight: 600; }
.sort-total { margin-left: auto; font-size: 22rpx; color: #94a3b8; }

/* 身份提示条：浅灰一行小字, 说清楚发出去的内容走哪条审核线 */
.id-tip { font-size: 22rpx; color: #94a3b8; padding: 0 8rpx 16rpx; }

.post-card { background: #fff; border-radius: 14rpx; padding: 22rpx 24rpx; margin-bottom: 16rpx; }
.pc-head { display: flex; align-items: center; flex-wrap: wrap; margin-bottom: 10rpx; }
.pc-cat { font-size: 21rpx; color: #64748b; background: #f1f5f9; border-radius: 6rpx; padding: 2rpx 12rpx; margin: 0 12rpx 0 10rpx; }
.pc-top, .pc-essence { font-size: 20rpx; border-radius: 6rpx; padding: 2rpx 10rpx; margin-right: 8rpx; }
.pc-top { color: #dc2626; background: #fef2f2; }
.pc-essence { color: #d97706; background: #fff7ed; }
.pc-author { font-size: 23rpx; color: #475569; margin-right: 10rpx; }
.pc-time { font-size: 21rpx; color: #94a3b8; margin-left: auto; }

.pc-title { font-size: 30rpx; font-weight: 600; color: #0f172a; line-height: 1.45; }
.pc-summary { font-size: 25rpx; color: #64748b; line-height: 1.55; margin-top: 8rpx; }

/* Batch E：工厂信任徽章与平台参考价 chip */
.pc-trust { display: inline-block; font-size: 21rpx; color: #0d9488; background: #f0fdfa; border-radius: 6rpx; padding: 2rpx 12rpx; margin-bottom: 8rpx; }
.pc-price { display: inline-block; font-size: 27rpx; font-weight: 600; color: #dc2626; margin-top: 8rpx; }
.pc-price-tip { font-size: 20rpx; font-weight: 400; color: #94a3b8; margin-left: 10rpx; }

/* 列表配图：一行三格, 第三格右上角压一个「+N」 */
.pc-imgs { display: flex; margin-top: 14rpx; }
.pc-img-wrap { position: relative; width: 200rpx; height: 150rpx; margin-right: 10rpx; border-radius: 10rpx; overflow: hidden; background: #f1f5f9; }
.pc-img { width: 100%; height: 100%; }
.pc-img-more {
  position: absolute; right: 0; top: 0;
  min-width: 46rpx; height: 34rpx; line-height: 34rpx;
  text-align: center;
  font-size: 21rpx; color: #fff; background: rgba(15,23,42,.6);
  border-radius: 0 0 0 10rpx;
}
.pc-img-video {
  position: absolute; left: 10rpx; bottom: 10rpx;
  width: 44rpx; height: 44rpx; line-height: 44rpx;
  text-align: center; font-size: 22rpx; color: #fff;
  background: rgba(15,23,42,.55); border-radius: 50%;
}

.pc-video-tip { display: flex; align-items: center; margin-top: 12rpx; font-size: 22rpx; color: #2563eb; }
.pc-video-ic { margin-right: 8rpx; font-size: 20rpx; }

.pc-foot { display: flex; align-items: center; margin-top: 14rpx; }
.pc-stat { font-size: 22rpx; color: #94a3b8; margin-right: 22rpx; }

.load-tip { text-align: center; color: #999; padding: 24rpx 0; font-size: 24rpx; }

/* 发帖悬浮按钮：抬到自定义 tabBar 之上（tabBar 约 104rpx + 安全区）*/
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 200rpx;
  width: 104rpx;
  height: 104rpx;
  line-height: 100rpx;
  text-align: center;
  font-size: 56rpx;
  color: #fff;
  border-radius: 50%;
  background: linear-gradient(135deg, #4f7cff 0%, #2563eb 60%);
  box-shadow: 0 10rpx 26rpx rgba(37, 99, 235, .35);
  z-index: 90;
}

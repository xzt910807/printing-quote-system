.navbar { position: fixed; top: 0; left: 0; right: 0; background: #fff; z-index: 100; box-shadow: 0 1px 4px rgba(0,0,0,.05); }
.navbar-inner { display: flex; align-items: center; justify-content: center; position: relative; }
/* 返回按钮：绝对定位贴最左 + 圆形浅灰底（与沟通消息/聊天页同款, 不挤占标题居中位） */
.navbar-back {
  position: absolute;
  left: 24rpx;
  bottom: 16rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 44rpx;
  color: #0f172a;
  border-radius: 50%;
  background: rgba(241, 245, 249, 0.9);
}
.navbar-title { text-align: center; font-size: 32rpx; font-weight: 400; color: #0f172a; }

.page { padding: 20rpx; min-height: 100vh; background: #f5f6fa; box-sizing: border-box; }

/* 搜索框（与我的页/找厂页同款） */
.search-bar { padding: 16rpx 0 4rpx; }
.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 999rpx;
  padding: 0 28rpx;
  height: 72rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.05);
}
.search-icon { display: flex; align-items: center; margin-right: 14rpx; color: #94a3b8; }
.search-input { flex: 1; font-size: 27rpx; color: #0f172a; height: 72rpx; }
.search-ph { color: #94a3b8; font-size: 27rpx; }
.search-clear {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #e2e8f0;
  color: #64748b;
  font-size: 22rpx;
  flex: none;
}

/* 状态筛选 chips（横滑, 找厂排序条同款语义） */
.chip-row { white-space: nowrap; padding: 14rpx 0 6rpx; }
.chip {
  display: inline-block;
  font-size: 25rpx;
  color: #475569;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 999rpx;
  padding: 10rpx 30rpx;
  margin-right: 14rpx;
}
.chip-on { color: #2563eb; background: #eff6ff; border-color: #bfdbfe; }

/* 工单卡：与全局列表卡同一视觉语言（20rpx 圆角 + 轻投影） */
.tk-card { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.05); }
.tk-head { display: flex; justify-content: space-between; align-items: center; }
.tk-no { font-size: 24rpx; color: #94a3b8; font-family: monospace; }
/* 可复制工单号：加粗加深 + 按压变蓝 + ⧉ 图标（同我的页单号规范） */
.tk-no-copy { font-weight: 600; color: #64748b; letter-spacing: 1rpx; }
.tk-no-copy:active { color: #2563eb; }
.tk-copy-ic { font-size: 20rpx; color: #cbd5e1; margin-left: 8rpx; }
.tk-status { font-size: 21rpx; padding: 4rpx 18rpx; border-radius: 999rpx; }
.st-open { background: #fef3cd; color: #b45309; }
.st-processing { background: #cfe2ff; color: #1d4ed8; }
.st-resolved { background: #d1e7dd; color: #15803d; }
.st-closed { background: #e9ecef; color: #64748b; }
.tk-title { font-size: 30rpx; color: #0f172a; font-weight: 600; margin: 14rpx 0 0; }
.tk-meta { display: flex; align-items: center; gap: 14rpx; margin-top: 14rpx; font-size: 22rpx; color: #94a3b8; }
.tk-type { color: #2563eb; background: #eff6ff; padding: 4rpx 18rpx; border-radius: 999rpx; flex: none; }
.tk-order { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.tk-time { flex: none; }

/* 分页脚注（全局列表统一） */
.list-end { text-align: center; font-size: 23rpx; color: #94a3b8; padding: 8rpx 0 40rpx; }

.empty { text-align: center; color: #999; padding: 100rpx 0; font-size: 26rpx; }

/* 表单遮罩 + 底部弹层（scroll-view 可滚动，内容多时不再被裁切；底部留安全区） */
.form-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.5); z-index: 200; display: flex; align-items: flex-end; }
.form-panel { width: 100%; max-height: 80vh; background: #fff; border-radius: 20rpx 20rpx 0 0; padding: 32rpx 24rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.form-title { font-size: 34rpx; font-weight: 600; margin-bottom: 20rpx; }
.form-row { margin-bottom: 24rpx; }
.form-label { display: block; font-size: 26rpx; color: #666; margin-bottom: 8rpx; }
/* input 是原生组件: 不设显式高度时默认高度偏小, 叠 border-box + 上下 padding 会压扁文字区导致 placeholder 被裁, 故固定高度只留左右内边距 */
.form-input {
  display: block;
  height: 88rpx;
  border: 1rpx solid #dcdfe6;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}
.form-textarea { border: 1rpx solid #dcdfe6; border-radius: 8rpx; padding: 16rpx; font-size: 28rpx; width: 100%; height: 200rpx; box-sizing: border-box; }
.type-cells { display: flex; flex-wrap: wrap; gap: 12rpx; }
.type-cell { padding: 12rpx 24rpx; background: #f2f3f5; border-radius: 30rpx; font-size: 26rpx; color: #666; }
.type-active { background: #2563eb; color: #fff; }
.img-cells { display: flex; flex-wrap: wrap; gap: 12rpx; }
.img-cell { position: relative; width: 150rpx; height: 150rpx; }
.img-prev { width: 100%; height: 100%; border-radius: 8rpx; }
.img-del { position: absolute; top: -10rpx; right: -10rpx; width: 40rpx; height: 40rpx; background: rgba(0,0,0,.5); color: #fff; border-radius: 50%; text-align: center; line-height: 40rpx; font-size: 32rpx; }
.img-add { width: 150rpx; height: 150rpx; border: 2rpx dashed #dcdfe6; border-radius: 8rpx; display: flex; align-items: center; justify-content: center; font-size: 60rpx; color: #999; }
.form-btns { display: flex; gap: 16rpx; margin-top: 20rpx; }
.btn-ghost { flex: 1; text-align: center; padding: 24rpx; background: #f2f3f5; color: #666; border-radius: 12rpx; font-size: 28rpx; }
.btn-primary { flex: 2; text-align: center; padding: 24rpx; background: #2563eb; color: #fff; border-radius: 12rpx; font-size: 28rpx; }
.btn-primary.disabled { background: #999; }

/* 右下角悬浮新建按钮 */
.fab {
  position: fixed;
  right: 36rpx;
  bottom: calc(80rpx + env(safe-area-inset-bottom));
  padding: 24rpx 40rpx;
  background: #2563eb;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 999rpx;
  box-shadow: 0 10rpx 28rpx rgba(37, 99, 235, .35);
  z-index: 90;
}
.fab:active { opacity: .85; transform: scale(.97); }

<view class="navbar" style="padding-top: {{statusBarHeight}}px;">
  <view class="navbar-inner" style="height: {{navBarHeight}}px;">
    <view class="navbar-back" bindtap="goBack">‹</view>
    <view class="navbar-title">售后工单</view>
  </view>
</view>

<view class="page" style="padding-top: {{statusBarHeight + navBarHeight + 10}}px;">

  <!-- 搜索 + 状态筛选（服务端过滤, 与我的页/找厂页同款交互） -->
  <view class="search-bar">
    <view class="search-box">
      <view class="search-icon"><view class="ic ic-search"><view class="ic-a"></view></view></view>
      <input class="search-input" value="{{searchKeyword}}" placeholder="搜索工单号 / 标题 / 订单号 / 工厂"
             placeholder-class="search-ph" confirm-type="search" bindinput="onSearchInput" />
      <text class="search-clear" wx:if="{{searchKeyword}}" bindtap="clearSearch">✕</text>
    </view>
  </view>
  <scroll-view class="chip-row" scroll-x enhanced show-scrollbar="{{false}}">
    <view wx:for="{{statusChips}}" wx:key="key"
          class="chip {{status === item.key ? 'chip-on' : ''}}"
          data-k="{{item.key}}" bindtap="setStatus">{{item.label}}</view>
  </scroll-view>


  <!-- 新建表单（底部弹层，scroll-view 可滚动防内容裁切；点遮罩关闭） -->
  <view class="form-mask" wx:if="{{showForm}}" bindtap="toggleForm">
    <scroll-view class="form-panel" scroll-y catchtap="noop">
      <view class="form-title">新建工单</view>

      <view class="form-row">
        <text class="form-label">订单号</text>
        <input class="form-input" type="number" placeholder="填写要反馈的订单 ID"
               value="{{formOrderId}}" bindinput="onInputOrderId"/>
      </view>

      <view class="form-row">
        <text class="form-label">问题类型</text>
        <view class="type-cells">
          <view wx:for="{{formTypes}}" wx:key="key"
                class="type-cell {{formType === item.key ? 'type-active' : ''}}"
                data-k="{{item.key}}" bindtap="setFormType">{{item.label}}</view>
        </view>
      </view>

      <view class="form-row">
        <text class="form-label">标题 *</text>
        <input class="form-input" placeholder="简要描述问题"
               value="{{formTitle}}" bindinput="onInputTitle"/>
      </view>

      <view class="form-row">
        <text class="form-label">详细描述</text>
        <textarea class="form-textarea" placeholder="补充细节、时间、批号等"
                  value="{{formDesc}}" bindinput="onInputDesc"/>
      </view>

      <view class="form-row">
        <text class="form-label">凭证图（最多 6 张）</text>
        <view class="img-cells">
          <view class="img-cell" wx:for="{{formImages}}" wx:key="*this" wx:for-index="i">
            <image src="{{item}}" mode="aspectFill" class="img-prev"/>
            <text class="img-del" data-i="{{i}}" catchtap="removeImage">×</text>
          </view>
          <view class="img-add" wx:if="{{formImages.length < 6}}" bindtap="chooseImages">+</view>
        </view>
      </view>

      <view class="form-btns">
        <view class="btn-ghost" bindtap="toggleForm">取消</view>
        <view class="btn-primary {{submitting ? 'disabled' : ''}}" bindtap="submit">
          {{submitting ? '提交中…' : '提交工单'}}
        </view>
      </view>
    </scroll-view>
  </view>
  
  <!-- 工单列表 -->
  <view wx:if="{{!list.length && !loading}}" class="empty">
    {{searchKeyword ? '没有匹配的工单' : (status ? '该状态下暂无工单' : '暂无工单，点右下角“发起工单”申请售后')}}
  </view>

  <view class="tk-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
    <view class="tk-head">
      <!-- 工单号可复制（与询价/订单单号同交互, catchtap 不触发卡片跳转） -->
      <text class="tk-no tk-no-copy" catchtap="copyTicketNo" data-no="{{item.ticket_no}}">{{item.ticket_no}}<text class="tk-copy-ic">⧉</text></text>
      <text class="tk-status st-{{item.status}}">{{item.statusLabel}}</text>
    </view>
    <view class="tk-title">{{item.title}}</view>
    <view class="tk-meta">
      <text class="tk-type">{{item.typeLabel}}</text>
      <text class="tk-order">订单 {{item.order_no || ('#' + item.order_id)}}</text>
      <text class="tk-time">{{item.timeText}}</text>
    </view>
  </view>
  <view class="list-end" wx:if="{{loadingMore}}">加载中…</view>
  <view class="list-end" wx:elif="{{list.length && !hasMore}}">— 已加载全部 —</view>

  <!-- 新建入口悬浮按钮（避开右上角胶囊遮挡） -->
  <view class="fab" wx:if="{{!showForm}}" bindtap="toggleForm">＋ 发起工单</view>

</view>

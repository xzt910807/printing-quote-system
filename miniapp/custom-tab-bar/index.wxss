.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  background: #fff;
  border-top: 2rpx solid #f1f5f9;
  box-shadow: 0 -4rpx 20rpx rgba(15, 23, 42, 0.06);
  padding-bottom: env(safe-area-inset-bottom);
}

.tabbar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0 10rpx;
}

.tbi-icon {
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  color: #b6c2d2;
  transition: color 0.15s, transform 0.15s;
}

.tbi-text {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 6rpx;
}

.on .tbi-icon { color: #2563eb; transform: translateY(-2rpx); }

.on .tbi-text { color: #2563eb; font-weight: 600; }

.tbi-badge {
  position: absolute;
  top: -10rpx;
  right: -30rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  background: #ef4444;
  color: #fff;
  font-size: 20rpx;
  border-radius: 999rpx;
  padding: 0 6rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(239, 68, 68, 0.4);
}
